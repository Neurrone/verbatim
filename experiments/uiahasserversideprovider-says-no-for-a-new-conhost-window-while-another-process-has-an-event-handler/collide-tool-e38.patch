index 00000000..3fa0e2da
--- /dev/null
+++ b/crates/collide/src/client.rs
@@ -0,0 +1,787 @@
+//! A UIA and MSAA client driven one command per line on standard input,
+//! each command one kind of first call into the server.
+
+use std::ffi::c_void;
+use std::io::BufRead;
+
+use windows::Win32::Foundation::HWND;
+use windows::Win32::System::Com::{
+    CLSCTX_INPROC_SERVER, COINIT_MULTITHREADED, CoCreateInstance, CoInitializeEx,
+};
+use windows::Win32::System::Variant::VARIANT;
+use windows::Win32::UI::Accessibility::{
+    AccessibleObjectFromEvent, AccessibleObjectFromWindow, CUIAutomation8, IAccessible,
+    IUIAutomation, IUIAutomationElement, IUIAutomationEventHandler, IUIAutomationEventHandler_Impl,
+    TreeScope_Subtree, UIA_EVENT_ID, UIA_PROPERTY_ID, UIA_NamePropertyId, UIA_NativeWindowHandlePropertyId, UIA_ToolTipOpenedEventId,
+    UiaHasServerSideProvider,
+};
+use windows::Win32::Foundation::{LPARAM, WPARAM};
+use windows::Win32::UI::Accessibility::UiaRootObjectId;
+use windows::Win32::UI::WindowsAndMessaging::{
+    CHILDID_SELF, OBJID_CLIENT, SMTO_ABORTIFHUNG, SendMessageTimeoutW, WM_GETOBJECT,
+};
+use windows::core::{Interface, Ref, Result, implement};
+
+use crate::{now_us, say, tod};
+
+#[implement(IUIAutomationEventHandler)]
+struct Handler;
+
+impl IUIAutomationEventHandler_Impl for Handler_Impl {
+    fn HandleAutomationEvent(&self, _: Ref<'_, IUIAutomationElement>, _: UIA_EVENT_ID) -> Result<()> {
+        Ok(())
+    }
+}
+
+struct State {
+    hwnd: HWND,
+    uia: Option<IUIAutomation>,
+    element: Option<IUIAutomationElement>,
+    handlers: Vec<IUIAutomationEventHandler>,
+    keep: Vec<verbatim_uia::Registration>,
+}
+
+pub fn main(args: &[String]) {
+    let hwnd: isize = args[0].parse().unwrap();
+    let tag = args.get(1).cloned().unwrap_or_default();
+    // SAFETY: this thread's own initialization.
+    unsafe { CoInitializeEx(None, COINIT_MULTITHREADED) }.ok().unwrap();
+    let mut state = State {
+        hwnd: HWND(hwnd as *mut c_void),
+        uia: None,
+        element: None,
+        handlers: Vec::new(),
+        keep: Vec::new(),
+    };
+    say(&format!("client-ready {tag}"));
+    for line in std::io::stdin().lock().lines() {
+        let Ok(line) = line else { break };
+        let line = line.trim().to_owned();
+        if line == "quit" {
+            break;
+        }
+        if let Some(hwnd) = line.strip_prefix("target ") {
+            state.hwnd = HWND(hwnd.parse::<isize>().unwrap() as *mut c_void);
+            state.element = None;
+            say(&format!("done target {tag}"));
+            continue;
+        }
+        if line == "ownwindow" {
+            // A hidden top-level window of this process's own (a plain
+            // static control), made the target of the calls that follow.
+            // SAFETY: a system class and a valid title.
+            let hwnd = unsafe {
+                windows::Win32::UI::WindowsAndMessaging::CreateWindowExW(
+                    windows::Win32::UI::WindowsAndMessaging::WINDOW_EX_STYLE(0),
+                    windows::core::w!("Static"),
+                    windows::core::w!("collide-client-own"),
+                    windows::Win32::UI::WindowsAndMessaging::WS_OVERLAPPED,
+                    0,
+                    0,
+                    100,
+                    100,
+                    None,
+                    None,
+                    None,
+                    None,
+                )
+            };
+            match hwnd {
+                Ok(hwnd) => {
+                    state.hwnd = hwnd;
+                    state.element = None;
+                    say(&format!("done ownwindow {tag} hwnd={}", hwnd.0 as isize));
+                }
+                Err(e) => say(&format!("done ownwindow {tag} err {e:?}")),
+            }
+            continue;
+        }
+        if let Some(command) = line.strip_prefix("async ") {
+            let command = command.to_owned();
+            let hwnd = state.hwnd.0 as isize;
+            let uia = state.uia.clone().map(|u| u.into_raw() as usize);
+            let element = state.element.clone().map(|e| e.into_raw() as usize);
+            let tag = tag.clone();
+            std::thread::spawn(move || {
+                // SAFETY: this thread's own initialization (the MTA, as the
+                // main thread's, so the pointers stay valid here).
+                unsafe { CoInitializeEx(None, COINIT_MULTITHREADED) }.ok().unwrap();
+                let mut state = State {
+                    hwnd: HWND(hwnd as *mut c_void),
+                    // SAFETY: references moved from the main thread, same apartment.
+                    uia: uia.map(|u| unsafe { IUIAutomation::from_raw(u as *mut c_void) }),
+                    // SAFETY: as above.
+                    element: element.map(|e| unsafe { IUIAutomationElement::from_raw(e as *mut c_void) }),
+                    handlers: Vec::new(),
+                    keep: Vec::new(),
+                };
+                let start = now_us();
+                let detail = run(&mut state, &command);
+                #[allow(clippy::cast_precision_loss)]
+                let ms = (now_us() - start) as f64 / 1000.0;
+                say(&format!("done async-{command} {tag} start={} ms={ms:.1} {detail}", tod(start)));
+                std::mem::forget(state);
+            });
+            continue;
+        }
+        let start = now_us();
+        let detail = run(&mut state, &line);
+        let end = now_us();
+        #[allow(clippy::cast_precision_loss)]
+        let ms = (end - start) as f64 / 1000.0;
+        say(&format!(
+            "done {line} {tag} start={} ms={ms:.1} {detail}",
+            tod(start)
+        ));
+    }
+}
+
+fn run(state: &mut State, command: &str) -> String {
+    match command {
+        "init" => {
+            // SAFETY: an in-process class.
+            match unsafe { CoCreateInstance::<_, IUIAutomation>(&CUIAutomation8, None, CLSCTX_INPROC_SERVER) } {
+                Ok(uia) => {
+                    state.uia = Some(uia);
+                    "ok".into()
+                }
+                Err(e) => format!("err {e:?}"),
+            }
+        }
+        "timeouts" => {
+            let uia: windows::Win32::UI::Accessibility::IUIAutomation2 =
+                state.uia.as_ref().unwrap().cast().unwrap();
+            // SAFETY: plain setters on a live client.
+            unsafe {
+                uia.SetConnectionTimeout(2000).unwrap();
+                uia.SetTransactionTimeout(2000).unwrap();
+            }
+            "ok".into()
+        }
+        "efocus" => {
+            let uia = state.uia.as_ref().unwrap();
+            // SAFETY: a plain COM call on a live client.
+            match unsafe { uia.GetFocusedElement() } {
+                Ok(element) => {
+                    // SAFETY: a live element.
+                    let id = unsafe { element.CurrentProcessId() }.unwrap_or(0);
+                    state.element = Some(element);
+                    format!("ok pid={id}")
+                }
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "rawprobe" => {
+            let mut answer = 0usize;
+            #[allow(clippy::cast_sign_loss)]
+            // SAFETY: a plain message with a valid out pointer.
+            let sent = unsafe {
+                SendMessageTimeoutW(
+                    state.hwnd,
+                    WM_GETOBJECT,
+                    WPARAM(0),
+                    LPARAM(UiaRootObjectId as isize),
+                    SMTO_ABORTIFHUNG,
+                    3000,
+                    Some(&raw mut answer),
+                )
+            };
+            format!("sent={} lresult={answer:#x}", sent.0)
+        }
+        "probe" => {
+            // SAFETY: any window handle is tolerated.
+            let yes = unsafe { UiaHasServerSideProvider(state.hwnd) }.as_bool();
+            format!("result={yes}")
+        }
+        "efh" => {
+            let uia = state.uia.as_ref().unwrap();
+            // SAFETY: any window handle is tolerated.
+            match unsafe { uia.ElementFromHandle(state.hwnd) } {
+                Ok(element) => {
+                    state.element = Some(element);
+                    "ok".into()
+                }
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "efhbc" => {
+            let uia = state.uia.as_ref().unwrap();
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = uia.CreateCacheRequest()?;
+                    request.AddProperty(UIA_NamePropertyId)?;
+                    let element = uia.ElementFromHandleBuildCache(state.hwnd, &request)?;
+                    let name = element.CachedName()?;
+                    state.element = Some(element);
+                    Ok(name.to_string())
+                }
+            })();
+            match result {
+                Ok(name) => format!("ok name={name:?}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "efhbcd" => {
+            // e37: ElementFromHandleBuildCache with the name, process id
+            // and provider description cached, so the one call shows
+            // whose provider the element has.
+            let uia = state.uia.as_ref().unwrap();
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = uia.CreateCacheRequest()?;
+                    request.AddProperty(UIA_NamePropertyId)?;
+                    request.AddProperty(windows::Win32::UI::Accessibility::UIA_ProcessIdPropertyId)?;
+                    request.AddProperty(UIA_PROPERTY_ID(30107))?;
+                    let element = uia.ElementFromHandleBuildCache(state.hwnd, &request)?;
+                    let name = element.CachedName()?;
+                    let pid = element.CachedProcessId()?;
+                    let desc = element.GetCachedPropertyValue(UIA_PROPERTY_ID(30107))?;
+                    state.element = Some(element);
+                    Ok(format!("name={:?} pid={pid} desc={:?}", name.to_string(), desc.to_string()))
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "children" | "descendants" => {
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            let scope = if command == "children" {
+                windows::Win32::UI::Accessibility::TreeScope_Children
+            } else {
+                windows::Win32::UI::Accessibility::TreeScope_Descendants
+            };
+            // SAFETY: plain COM calls on live objects.
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = uia.CreateCacheRequest()?;
+                    request.AddProperty(UIA_NamePropertyId)?;
+                    request.AddProperty(UIA_NativeWindowHandlePropertyId)?;
+                    let all = element.FindAllBuildCache(scope, &uia.CreateTrueCondition()?, &request)?;
+                    let mut out = Vec::new();
+                    for i in 0..all.Length()? {
+                        out.push(describe(&all.GetElement(i)?));
+                    }
+                    Ok(format!("count={} {}", out.len(), out.join(" | ")))
+                }
+            })();
+            match result {
+                Ok(n) => format!("ok {n}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "parent" | "firstchild" => {
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = uia.CreateCacheRequest()?;
+                    request.AddProperty(UIA_NamePropertyId)?;
+                    request.AddProperty(UIA_NativeWindowHandlePropertyId)?;
+                    let walker = uia.RawViewWalker()?;
+                    let found = if command == "parent" {
+                        walker.GetParentElementBuildCache(element, &request)?
+                    } else {
+                        walker.GetFirstChildElementBuildCache(element, &request)?
+                    };
+                    Ok(describe(&found))
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "normalize" => {
+            // A walker whose condition excludes the held element's own
+            // window, so normalizing it walks up to its parent window.
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let own = element.CurrentNativeWindowHandle()?;
+                    #[allow(clippy::cast_possible_truncation)]
+                    let is_own = uia.CreatePropertyCondition(
+                        UIA_NativeWindowHandlePropertyId,
+                        &VARIANT::from(own.0 as i32),
+                    )?;
+                    let not_own = uia.CreateNotCondition(&is_own)?;
+                    let walker = uia.CreateTreeWalker(&not_own)?;
+                    let request = uia.CreateCacheRequest()?;
+                    request.AddProperty(UIA_NamePropertyId)?;
+                    request.AddProperty(UIA_NativeWindowHandlePropertyId)?;
+                    let found = walker.NormalizeElementBuildCache(element, &request)?;
+                    Ok(describe(&found))
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "cachechildren" => {
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = uia.CreateCacheRequest()?;
+                    request.AddProperty(UIA_NamePropertyId)?;
+                    request.AddProperty(UIA_NativeWindowHandlePropertyId)?;
+                    request.SetTreeScope(windows::Win32::UI::Accessibility::TreeScope_Children)?;
+                    let updated = element.BuildUpdatedCache(&request)?;
+                    let children = updated.GetCachedChildren()?;
+                    let mut out = Vec::new();
+                    for i in 0..children.Length()? {
+                        out.push(describe(&children.GetElement(i)?));
+                    }
+                    Ok(format!("count={} {}", out.len(), out.join(" | ")))
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "walk" => {
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            // SAFETY: plain COM calls on live objects.
+            match unsafe { uia.RawViewWalker().and_then(|w| w.GetFirstChildElement(element)).and_then(|c| Ok(format!("{:?} hwnd={}", c.CurrentName()?.to_string(), c.CurrentNativeWindowHandle()?.0 as isize))) } {
+                Ok(n) => format!("ok first={n}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "name" => match state.element.as_ref() {
+            // SAFETY: a live element.
+            Some(element) => match unsafe { element.CurrentName() } {
+                Ok(name) => format!("ok name={:?}", name.to_string()),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            },
+            None => "err no element".into(),
+        },
+        "getfocus" => {
+            let uia = state.uia.as_ref().unwrap();
+            // SAFETY: plain COM calls on live objects.
+            match unsafe { uia.GetFocusedElement().and_then(|e| e.CurrentName()) } {
+                Ok(name) => format!("ok name={:?}", name.to_string()),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "events" => {
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            let handler: IUIAutomationEventHandler = Handler.into();
+            // SAFETY: plain COM calls on live objects.
+            match unsafe {
+                uia.AddAutomationEventHandler(
+                    UIA_ToolTipOpenedEventId,
+                    element,
+                    TreeScope_Subtree,
+                    None,
+                    &handler,
+                )
+            } {
+                Ok(()) => {
+                    state.handlers.push(handler);
+                    "ok".into()
+                }
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "rop" | "ropname" => {
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            let mut builder = verbatim_uia_rops::Builder::new();
+            let reg = builder.import_element(element);
+            builder.add_to_results(reg);
+            let name = (command == "ropname").then(|| {
+                let name = builder.property(reg, UIA_NamePropertyId.0);
+                builder.add_to_results(name)
+            });
+            let operation = builder.finish();
+            match operation.execute() {
+                Ok(outcome) => match name {
+                    Some(name) => format!(
+                        "ok name={:?}",
+                        outcome.get(name)
+                    ),
+                    None => "ok".into(),
+                },
+                Err(e) => format!("err {e:?}"),
+            }
+        }
+        "msaa" => {
+            let mut raw: *mut c_void = std::ptr::null_mut();
+            #[allow(clippy::cast_sign_loss)]
+            // SAFETY: a valid out pointer.
+            let result = unsafe {
+                AccessibleObjectFromWindow(
+                    state.hwnd,
+                    OBJID_CLIENT.0 as u32,
+                    &IAccessible::IID,
+                    &raw mut raw,
+                )
+            };
+            match result {
+                Ok(()) => {
+                    // SAFETY: the object the call returned.
+                    let accessible = unsafe { IAccessible::from_raw(raw) };
+                    // SAFETY: a live object.
+                    match unsafe { accessible.get_accName(&VARIANT::from(0i32)) } {
+                        Ok(name) => format!("ok name={:?}", name.to_string()),
+                        Err(e) => format!("ok-object name-err {:#x} {}", e.code().0, e.message()),
+                    }
+                }
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "msaaevent" => {
+            let mut accessible: Option<IAccessible> = None;
+            let mut child = VARIANT::default();
+            #[allow(clippy::cast_sign_loss)]
+            // SAFETY: valid out pointers.
+            let result = unsafe {
+                AccessibleObjectFromEvent(
+                    state.hwnd,
+                    OBJID_CLIENT.0 as u32,
+                    CHILDID_SELF as u32,
+                    &raw mut accessible,
+                    &raw mut child,
+                )
+            };
+            match (result, accessible) {
+                (Ok(()), Some(accessible)) => {
+                    // SAFETY: a live object.
+                    match unsafe { accessible.get_accName(&child) } {
+                        Ok(name) => format!("ok name={:?}", name.to_string()),
+                        Err(e) => format!("ok-object name-err {:#x} {}", e.code().0, e.message()),
+                    }
+                }
+                (Ok(()), None) => "err null".into(),
+                (Err(e), _) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "rootwalk" | "rootwalkcv" => {
+            // A downward walk from the desktop root, sibling by sibling,
+            // until the child whose window is the target.
+            let uia = state.uia.as_ref().unwrap();
+            let target = state.hwnd.0 as isize;
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = full_request(uia)?;
+                    let walker = if command == "rootwalk" {
+                        uia.RawViewWalker()?
+                    } else {
+                        uia.ControlViewWalker()?
+                    };
+                    let root = uia.GetRootElement()?;
+                    let mut steps = 0;
+                    let mut slow = Vec::new();
+                    let mut t = now_us();
+                    let mut current = walker.GetFirstChildElementBuildCache(&root, &request);
+                    loop {
+                        let element = current?;
+                        steps += 1;
+                        let now = now_us();
+                        let took = now - t;
+                        let hwnd = element.CachedNativeWindowHandle().map_or(-1, |h| h.0 as isize);
+                        if took >= 20_000 {
+                            slow.push(format!("step{steps}={}ms[{}]", took / 1000, describe(&element)));
+                        }
+                        if hwnd == target {
+                            let text = describe(&element);
+                            state.element = Some(element);
+                            return Ok(format!(
+                                "found steps={steps} last-step-ms={:.1} at={} {text} slow=[{}]",
+                                took as f64 / 1000.0,
+                                tod(now),
+                                slow.join(" ")
+                            ));
+                        }
+                        t = now_us();
+                        current = walker.GetNextSiblingElementBuildCache(&element, &request);
+                    }
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "rootfind" | "rootfindall" => {
+            let uia = state.uia.as_ref().unwrap();
+            let target = state.hwnd.0 as isize;
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = full_request(uia)?;
+                    let root = uia.GetRootElement()?;
+                    if command == "rootfind" {
+                        #[allow(clippy::cast_possible_truncation)]
+                        let condition = uia.CreatePropertyCondition(
+                            UIA_NativeWindowHandlePropertyId,
+                            &VARIANT::from(target as i32),
+                        )?;
+                        let found = root.FindFirstBuildCache(
+                            windows::Win32::UI::Accessibility::TreeScope_Children,
+                            &condition,
+                            &request,
+                        )?;
+                        let text = describe(&found);
+                        state.element = Some(found);
+                        Ok(format!("found {text}"))
+                    } else {
+                        let all = root.FindAllBuildCache(
+                            windows::Win32::UI::Accessibility::TreeScope_Children,
+                            &uia.CreateTrueCondition()?,
+                            &request,
+                        )?;
+                        let count = all.Length()?;
+                        let mut others = Vec::new();
+                        let mut found = None;
+                        for i in 0..count {
+                            let element = all.GetElement(i)?;
+                            if element.CachedNativeWindowHandle().map_or(-1, |h| h.0 as isize) == target {
+                                found = Some((i, describe(&element)));
+                                state.element = Some(element);
+                            } else {
+                                let name = element.CachedName().map_or_else(|_| String::new(), |n| n.to_string());
+                                let pid = element.CachedProcessId().unwrap_or(0);
+                                others.push(format!("{name:?}/pid{pid}"));
+                            }
+                        }
+                        let others = others.join(", ");
+                        Ok(match found {
+                            Some((i, text)) => format!("found count={count} index={i} {text} others=[{others}]"),
+                            None => format!("notfound count={count} others=[{others}]"),
+                        })
+                    }
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "info" => {
+            // Current (uncached) reads on the held element, each timed.
+            let Some(element) = state.element.as_ref() else {
+                return "err no element".into();
+            };
+            let mut out = Vec::new();
+            let mut t = now_us();
+            let mut lap = |label: &str, value: String, out: &mut Vec<String>| {
+                let now = now_us();
+                #[allow(clippy::cast_precision_loss)]
+                out.push(format!("{label}={value}({:.1}ms)", (now - t) as f64 / 1000.0));
+                t = now;
+            };
+            // SAFETY: plain COM calls on a live element.
+            unsafe {
+                let v = element.CurrentName().map_or_else(|e| format!("<{:#x}>", e.code().0), |n| format!("{:?}", n.to_string()));
+                lap("name", v, &mut out);
+                let v = element.CurrentNativeWindowHandle().map_or_else(|e| format!("<{:#x}>", e.code().0), |h| (h.0 as isize).to_string());
+                lap("hwnd", v, &mut out);
+                let v = element.CurrentFrameworkId().map_or_else(|e| format!("<{:#x}>", e.code().0), |n| format!("{:?}", n.to_string()));
+                lap("framework", v, &mut out);
+                let v = element.CurrentProcessId().map_or_else(|e| format!("<{:#x}>", e.code().0), |p| p.to_string());
+                lap("pid", v, &mut out);
+                let v = element
+                    .GetCurrentPropertyValue(UIA_PROPERTY_ID(30107))
+                    .map_or_else(|e| format!("<{:#x}>", e.code().0), |d| format!("{:?}", d.to_string()));
+                lap("desc", v, &mut out);
+            }
+            format!("ok {}", out.join(" "))
+        }
+        "docchild" => {
+            // The first descendant that is a document (a console's text
+            // area), held in place of the element.
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.clone() else {
+                return "err no element".into();
+            };
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = full_request(uia)?;
+                    let condition = uia.CreatePropertyCondition(
+                        windows::Win32::UI::Accessibility::UIA_ControlTypePropertyId,
+                        &VARIANT::from(windows::Win32::UI::Accessibility::UIA_DocumentControlTypeId.0),
+                    )?;
+                    let found = element.FindFirstBuildCache(
+                        windows::Win32::UI::Accessibility::TreeScope_Descendants,
+                        &condition,
+                        &request,
+                    )?;
+                    let text = describe(&found);
+                    state.element = Some(found);
+                    Ok(text)
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "holdfirstchild" => {
+            // As firstchild, but the child found becomes the held element.
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.clone() else {
+                return "err no element".into();
+            };
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = full_request(uia)?;
+                    let found = uia.RawViewWalker()?.GetFirstChildElementBuildCache(&element, &request)?;
+                    let text = describe(&found);
+                    state.element = Some(found);
+                    Ok(text)
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "toplevel" | "toplevelcv" => {
+            // A classic upward walk, parent by parent, to the element just
+            // under the desktop root; each step timed.
+            let uia = state.uia.as_ref().unwrap();
+            let Some(element) = state.element.clone() else {
+                return "err no element".into();
+            };
+            let result = (|| -> Result<String> {
+                // SAFETY: plain COM calls on live objects.
+                unsafe {
+                    let request = full_request(uia)?;
+                    let walker = if command == "toplevel" {
+                        uia.RawViewWalker()?
+                    } else {
+                        uia.ControlViewWalker()?
+                    };
+                    let root = uia.GetRootElement()?;
+                    let mut current = element;
+                    let mut steps = Vec::new();
+                    loop {
+                        let t = now_us();
+                        let parent = walker.GetParentElementBuildCache(&current, &request)?;
+                        #[allow(clippy::cast_precision_loss)]
+                        let ms = (now_us() - t) as f64 / 1000.0;
+                        if uia.CompareElements(&parent, &root)?.as_bool() {
+                            let text = describe(&current);
+                            state.element = Some(current);
+                            return Ok(format!("top {text} steps=[{}]", steps.join(" ")));
+                        }
+                        steps.push(format!("{ms:.1}ms->[{}]", describe(&parent)));
+                        current = parent;
+                    }
+                }
+            })();
+            match result {
+                Ok(text) => format!("ok {text}"),
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "root" => {
+            let uia = state.uia.as_ref().unwrap();
+            // SAFETY: a plain COM call on a live client.
+            match unsafe { uia.GetRootElement() } {
+                Ok(element) => {
+                    state.element = Some(element);
+                    "ok".into()
+                }
+                Err(e) => format!("err {:#x} {}", e.code().0, e.message()),
+            }
+        }
+        "spare" => match crate::e38::spare_registration() {
+            Ok(r) => {
+                state.keep.push(r);
+                "ok".into()
+            }
+            Err(e) => format!("err {e:?}"),
+        },
+        "hookapp" => {
+            let pid = verbatim_uia::lock::provider_process(state.hwnd.0 as isize).unwrap_or(0);
+            crate::e38::hook(pid);
+            format!("ok pid={pid}")
+        }
+        c if c.starts_with("hookpid ") => {
+            let pid: u32 = c[8..].trim().parse().unwrap();
+            crate::e38::hook(pid);
+            format!("ok pid={pid}")
+        }
+        "outpost" => {
+            let detail = run(state, "efhbcd");
+            let Some(element) = state.element.clone() else {
+                return format!("err no element {detail}");
+            };
+            match crate::e38::outpost_registration(&element) {
+                Ok(r) => state.keep.push(r),
+                Err(e) => return format!("err {e:?}"),
+            }
+            let pid = verbatim_uia::lock::provider_process(state.hwnd.0 as isize).unwrap_or(0);
+            crate::e38::hook(pid);
+            format!("ok hookpid={pid} {detail}")
+        }
+        other => format!("unknown {other}"),
+    }
+}
+
+/// A cache request for the properties `describe` prints, the provider
+/// description included, which names the application's own provider when
+/// it is part of the element and only UIA's proxies when it is not.
+fn full_request(uia: &IUIAutomation) -> Result<windows::Win32::UI::Accessibility::IUIAutomationCacheRequest> {
+    // SAFETY: plain COM calls on a live client.
+    unsafe {
+        let request = uia.CreateCacheRequest()?;
+        request.AddProperty(UIA_NamePropertyId)?;
+        request.AddProperty(UIA_NativeWindowHandlePropertyId)?;
+        request.AddProperty(windows::Win32::UI::Accessibility::UIA_ProcessIdPropertyId)?;
+        request.AddProperty(UIA_PROPERTY_ID(30107))?;
+        Ok(request)
+    }
+}
+
+/// An element's cached name and window handle, enough to tell the
+/// server's own provider (named "uia-provider") from UIA's window proxy
+/// (named by the window's title).
+fn describe(element: &IUIAutomationElement) -> String {
+    // SAFETY: cached reads on a live element.
+    unsafe {
+        let name = element
+            .CachedName()
+            .map_or_else(|e| format!("<{:#x}>", e.code().0), |n| n.to_string());
+        let hwnd = element.CachedNativeWindowHandle().map_or(-1, |h| h.0 as isize);
+        let mut text = format!("name={name:?} hwnd={hwnd}");
+        if let Ok(pid) = element.CachedProcessId() {
+            text.push_str(&format!(" pid={pid}"));
+        }
+        if let Ok(desc) = element.GetCachedPropertyValue(UIA_PROPERTY_ID(30107)) {
+            text.push_str(&format!(" desc={:?}", desc.to_string()));
+        }
+        text
+    }
+}
diff --git a/crates/collide/src/e38.rs b/crates/collide/src/e38.rs
new file mode 100644
index 00000000..f21ed24d
--- /dev/null
+++ b/crates/collide/src/e38.rs
@@ -0,0 +1,317 @@
+//! e38: the conditions of the real scenario around an early console probe.
+//!
+//! - `collide listen <tag> <title-prefix>`: a focus listener like Verbatim's:
+//!   one registration over the desktop (verbatim_uia's, as the listener
+//!   makes it: the focus handler on the client, then a group on the root
+//!   with selection, menu and notification parts, each shaped as
+//!   `ListenerEvent`), and a global out-of-context WinEvent hook. For each
+//!   UIA focus event from a console window whose title starts with the
+//!   prefix, its reading thread does what the listener's does: the provider
+//!   probe and console check of the window (once per window, as the
+//!   arbitrator keeps a yes), then the remote focus read
+//!   (`verbatim_uia_rops::focus_ancestry`, remote, with the listener's
+//!   query). Everything it does is printed with times.
+//! - client commands (in client.rs): `spare` (a registration over nothing,
+//!   as a spare outpost has from its start), `hookapp` (an out-of-context
+//!   WinEvent hook on the target window's console host, as an outpost
+//!   installs on assignment), `outpost` (ElementFromHandleBuildCache on the
+//!   target, a registration over its subtree, and `hookapp`).
+//! - `collide burn <threads> <ms>`: busy threads, for CPU load.
+
+use std::collections::HashSet;
+use std::io::BufRead;
+use std::sync::Arc;
+use std::sync::mpsc::channel;
+use std::time::Instant;
+
+use verbatim_uia::{
+    Agile, Ancestor, Cached, Fill, FocusInput, ListenerEvent, Part, Registration, Scope, Shape,
+    Subscription, Uia,
+};
+use verbatim_uia_rops::{FocusAncestry, FocusQuery, focus_ancestry};
+use windows::Win32::Foundation::HWND;
+use windows::Win32::UI::Accessibility::{
+    HWINEVENTHOOK, SetWinEventHook, UIA_MenuClosedEventId, UIA_MenuOpenedEventId,
+    UIA_SelectionItem_ElementSelectedEventId,
+};
+use windows::Win32::UI::WindowsAndMessaging::{
+    DispatchMessageW, EVENT_MAX, EVENT_MIN, GetClassNameW, GetMessageW, GetWindowTextW, MSG,
+    TranslateMessage, WINEVENT_OUTOFCONTEXT, WINEVENT_SKIPOWNPROCESS,
+};
+
+use crate::{now_us, say, tod};
+
+fn class_and_title(hwnd: isize) -> (String, String) {
+    let window = HWND(hwnd as *mut _);
+    let mut class = [0u16; 64];
+    let mut title = [0u16; 256];
+    // SAFETY: buffers outlive the calls; any handle is tolerated.
+    let (c, t) = unsafe { (GetClassNameW(window, &mut class), GetWindowTextW(window, &mut title)) };
+    (
+        String::from_utf16_lossy(&class[..usize::try_from(c).unwrap_or(0)]),
+        String::from_utf16_lossy(&title[..usize::try_from(t).unwrap_or(0)]),
+    )
+}
+
+unsafe extern "system" fn winevent(
+    _: HWINEVENTHOOK,
+    _: u32,
+    _: HWND,
+    _: i32,
+    _: i32,
+    _: u32,
+    _: u32,
+) {
+}
+
+/// Installs an out-of-context WinEvent hook for `pid` (0 for every
+/// process) on a thread of its own that pumps its messages, as Verbatim's
+/// hook threads do.
+pub fn hook(pid: u32) {
+    let (tx, rx) = channel();
+    std::thread::spawn(move || {
+        // SAFETY: a plain out-of-context hook with a callback that does nothing.
+        let hook = unsafe {
+            SetWinEventHook(
+                EVENT_MIN,
+                EVENT_MAX,
+                None,
+                Some(winevent),
+                pid,
+                0,
+                WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS,
+            )
+        };
+        let _ = tx.send(!hook.is_invalid());
+        let mut msg = MSG::default();
+        // SAFETY: this thread's own queue.
+        while unsafe { GetMessageW(&raw mut msg, None, 0, 0) }.as_bool() {
+            // SAFETY: a message just taken from this thread's queue.
+            unsafe {
+                let _ = TranslateMessage(&raw const msg);
+                DispatchMessageW(&raw const msg);
+            }
+        }
+    });
+    let _ = rx.recv();
+}
+
+/// The desktop registration the listener makes, with `focus` its focus part.
+fn desktop_registration(
+    focus: Subscription<Cached<ListenerEvent>>,
+) -> windows::core::Result<Registration> {
+    let selection = Subscription::Event {
+        event: UIA_SelectionItem_ElementSelectedEventId,
+        callback: Arc::new(|_: &Cached<ListenerEvent>| {}),
+    };
+    let menu = Subscription::Events {
+        events: vec![UIA_MenuOpenedEventId, UIA_MenuClosedEventId],
+        callback: Arc::new(|_: &Cached<ListenerEvent>, _| {}),
+    };
+    let notifications = Subscription::Notifications {
+        callback: Arc::new(|_: &Cached<ListenerEvent>, _, _, _, _| {}),
+    };
+    let parts = [focus, selection, menu, notifications]
+        .into_iter()
+        .map(Part::shaped::<ListenerEvent>)
+        .collect();
+    Registration::with_parts(parts, Scope::Desktop)
+}
+
+/// A registration over nothing, as a spare outpost holds from its start.
+pub fn spare_registration() -> windows::core::Result<Registration> {
+    let parts = vec![Part::shaped::<ListenerEvent>(Subscription::Events {
+        events: vec![
+            windows::Win32::UI::Accessibility::UIA_Text_TextChangedEventId,
+            windows::Win32::UI::Accessibility::UIA_Text_TextSelectionChangedEventId,
+        ],
+        callback: Arc::new(|_: &Cached<ListenerEvent>, _| {}),
+    })];
+    Registration::with_parts(parts, Scope::Nothing)
+}
+
+/// A registration over `element`'s subtree with an outpost's text events.
+pub fn outpost_registration(
+    element: &windows::Win32::UI::Accessibility::IUIAutomationElement,
+) -> windows::core::Result<Registration> {
+    let registration = spare_registration()?;
+    registration.retarget(Scope::Subtrees(vec![windows::core::AgileReference::new(element)?]));
+    registration.settle();
+    Ok(registration)
+}
+
+struct Delivered {
+    agile: Agile<ListenerEvent>,
+    window: isize,
+    received: u64,
+    rid: Vec<i32>,
+}
+
+pub fn listen(args: &[String]) {
+    let tag = args.first().cloned().unwrap_or_else(|| "L".into());
+    let prefix = args.get(1).cloned().unwrap_or_default();
+    // full (default): as described above; passive: the registrations and
+    // hook, reading nothing; noread: the probe and check, no remote read;
+    // nohook: no WinEvent hook; focusonly: the focus handler alone, no
+    // group; grouponly: the group alone, no focus handler (nothing read).
+    let mode = args.get(2).cloned().unwrap_or_else(|| "full".into());
+    verbatim_uia::init_mta().unwrap();
+    let (tx, rx) = channel::<Delivered>();
+    let callback_tag = tag.clone();
+    let focus = Subscription::Focus {
+        callback: Arc::new(move |sender: &Cached<ListenerEvent>| {
+            let received = now_us();
+            let rid = sender.runtime_id();
+            let fields = sender.read();
+            let window = if fields.role.hwnd != 0 {
+                fields.role.hwnd
+            } else if rid.first() == Some(&42) {
+                rid.get(1).map_or(0, |h| *h as isize)
+            } else {
+                0
+            };
+            let (class, title) = class_and_title(window);
+            if class != "ConsoleWindowClass" || !title.starts_with(&prefix) {
+                return;
+            }
+            say(&format!("{callback_tag} focus-event rid={rid:?} hwnd={window} pid={:?}", fields.process_id));
+            if let Ok(agile) = sender.agile() {
+                let _ = tx.send(Delivered { agile, window, received, rid });
+            }
+        }),
+    };
+    let started = now_us();
+    let registration = match mode.as_str() {
+        "focusonly" => Registration::with_parts(vec![Part::shaped::<ListenerEvent>(focus)], Scope::Desktop).unwrap(),
+        "grouponly" => group_registration().unwrap(),
+        _ => desktop_registration(focus).unwrap(),
+    };
+    registration.settle();
+    if mode != "nohook" {
+        hook(0);
+    }
+    #[allow(clippy::cast_precision_loss)]
+    let ms = (now_us() - started) as f64 / 1000.0;
+    say(&format!("listening {tag} mode={mode} ms={ms:.1}"));
+    let reader_tag = tag.clone();
+    if mode != "passive" && mode != "grouponly" {
+        let read = mode != "noread";
+        std::thread::spawn(move || read_focus(&reader_tag, &rx, read));
+    }
+    for line in std::io::stdin().lock().lines() {
+        let Ok(line) = line else { break };
+        if line.trim() == "quit" {
+            break;
+        }
+    }
+    registration.close();
+    drop(registration);
+}
+
+/// The listener's group on the root without the focus handler.
+fn group_registration() -> windows::core::Result<Registration> {
+    let parts = [
+        Subscription::Event {
+            event: UIA_SelectionItem_ElementSelectedEventId,
+            callback: Arc::new(|_: &Cached<ListenerEvent>| {}),
+        },
+        Subscription::Events {
+            events: vec![UIA_MenuOpenedEventId, UIA_MenuClosedEventId],
+            callback: Arc::new(|_: &Cached<ListenerEvent>, _| {}),
+        },
+        Subscription::Notifications {
+            callback: Arc::new(|_: &Cached<ListenerEvent>, _, _, _, _| {}),
+        },
+    ]
+    .into_iter()
+    .map(Part::shaped::<ListenerEvent>)
+    .collect();
+    Registration::with_parts(parts, Scope::Desktop)
+}
+
+/// The listener's reading thread: probe and console check once per window,
+/// then the remote focus read, for each event.
+fn read_focus(tag: &str, rx: &std::sync::mpsc::Receiver<Delivered>, read: bool) {
+    let uia = Uia::new().unwrap();
+    let request = uia.request::<Ancestor>(Ancestor::all_on()).unwrap();
+    let mut probed: HashSet<isize> = HashSet::new();
+    while let Ok(event) = rx.recv() {
+        let Ok(sender) = event.agile.resolve() else {
+            say(&format!("{tag} resolve-failed"));
+            continue;
+        };
+        #[allow(clippy::cast_precision_loss)]
+        let queued = (now_us() - event.received) as f64 / 1000.0;
+        if event.window != 0 && !probed.contains(&event.window) {
+            let start = now_us();
+            let yes = verbatim_uia::has_server_side_provider(event.window);
+            #[allow(clippy::cast_precision_loss)]
+            let ms = (now_us() - start) as f64 / 1000.0;
+            say(&format!("{tag} done lprobe start={} ms={ms:.1} hwnd={} result={yes}", tod(start), event.window));
+            if yes {
+                let start = now_us();
+                let usable = verbatim_uia::console_reports_formatting(event.window);
+                #[allow(clippy::cast_precision_loss)]
+                let ms = (now_us() - start) as f64 / 1000.0;
+                say(&format!("{tag} done lcheck start={} ms={ms:.1} usable={usable:?}", tod(start)));
+                probed.insert(event.window);
+            }
+        }
+        if !read {
+            continue;
+        }
+        let input: Cached<FocusInput> = sender.narrow::<FocusInput>();
+        let fill = Fill::new(&request);
+        let query = FocusQuery {
+            element: &input,
+            known: &[],
+            previous: None,
+            depth_limit: 16,
+            fill: &fill,
+            deadline: Some(Instant::now() + std::time::Duration::from_millis(500)),
+            require_focus: true,
+            refresh: true,
+            lock_up_from: None,
+        };
+        let start = now_us();
+        let read = focus_ancestry(&uia, &query, true);
+        #[allow(clippy::cast_precision_loss)]
+        let ms = (now_us() - start) as f64 / 1000.0;
+        let answer = match read {
+            Ok((FocusAncestry::NotFocused, path)) => format!("not-focused path={}", path.name()),
+            Ok((FocusAncestry::Focused(a), path)) => {
+                format!("focused ancestors={} path={}", a.ancestors.len(), path.name())
+            }
+            Err(e) => format!("err {e:?}"),
+        };
+        say(&format!(
+            "{tag} done lread start={} ms={ms:.1} queued_ms={queued:.1} rid={:?} {answer}",
+            tod(start),
+            event.rid
+        ));
+    }
+}
+
+/// Busy threads for `ms` milliseconds.
+pub fn burn(args: &[String]) {
+    let threads: usize = args[0].parse().unwrap();
+    let ms: u64 = args[1].parse().unwrap();
+    let until = Instant::now() + std::time::Duration::from_millis(ms);
+    let handles: Vec<_> = (0..threads)
+        .map(|_| {
+            std::thread::spawn(move || {
+                let mut x = 0u64;
+                while Instant::now() < until {
+                    for _ in 0..10_000 {
+                        x = x.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1);
+                    }
+                    std::hint::black_box(x);
+                }
+            })
+        })
+        .collect();
+    say(&format!("burning threads={threads} ms={ms}"));
+    for h in handles {
+        let _ = h.join();
+    }
+}
diff --git a/crates/collide/src/main.rs b/crates/collide/src/main.rs
new file mode 100644
index 00000000..880dbbfb
--- /dev/null
+++ b/crates/collide/src/main.rs
@@ -0,0 +1,76 @@
+//! Scratch tool: a UIA server, UIA clients and an orchestrator, to
+//! reproduce the first-connection collision with controlled timing.
+
+mod client;
+mod e38;
+mod run;
+mod server;
+
+use std::io::Write;
+use std::sync::Mutex;
+
+use windows::Win32::System::SystemInformation::GetSystemTimePreciseAsFileTime;
+
+static OUT: Mutex<()> = Mutex::new(());
+
+/// Microseconds since 1601, from the precise system clock (comparable
+/// across processes and with a trace's UTC times).
+pub fn now_us() -> u64 {
+    // SAFETY: no preconditions.
+    let ft = unsafe { GetSystemTimePreciseAsFileTime() };
+    ((u64::from(ft.dwHighDateTime) << 32) | u64::from(ft.dwLowDateTime)) / 10
+}
+
+/// UTC time of day, to the microsecond.
+pub fn tod(us: u64) -> String {
+    let day = us % 86_400_000_000;
+    format!(
+        "{:02}:{:02}:{:02}.{:06}",
+        day / 3_600_000_000,
+        day / 60_000_000 % 60,
+        day / 1_000_000 % 60,
+        day % 1_000_000
+    )
+}
+
+/// One line on standard output, with the time first.
+pub fn say(text: &str) {
+    let _guard = OUT.lock();
+    let mut out = std::io::stdout().lock();
+    let _ = writeln!(out, "{} {text}", tod(now_us()));
+    let _ = out.flush();
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    match args.get(1).map(String::as_str) {
+        Some("server") => server::main(&args[2..]),
+        Some("client") => client::main(&args[2..]),
+        Some("run") => run::main(&args[2..]),
+        Some("listen") => e38::listen(&args[2..]),
+        Some("burn") => e38::burn(&args[2..]),
+        Some("mutexbench") => mutex_bench(),
+        _ => eprintln!("usage: collide server|client|run ..."),
+    }
+}
+
+/// Times an uncontended named mutex's acquire and release, as a per-call
+/// gate between two processes would pay it.
+fn mutex_bench() {
+    use windows::Win32::System::Threading::{CreateMutexW, ReleaseMutex, WaitForSingleObject, INFINITE};
+    let name: Vec<u16> = "Local\\verbatim-scratch-bench".encode_utf16().chain(Some(0)).collect();
+    // SAFETY: a named mutex this process creates and closes at exit.
+    let mutex = unsafe { CreateMutexW(None, false, windows::core::PCWSTR(name.as_ptr())) }.unwrap();
+    let rounds = 200_000u64;
+    let start = now_us();
+    for _ in 0..rounds {
+        // SAFETY: a live handle.
+        unsafe {
+            WaitForSingleObject(mutex, INFINITE);
+            let _ = ReleaseMutex(mutex);
+        }
+    }
+    #[allow(clippy::cast_precision_loss)]
+    let each = (now_us() - start) as f64 / rounds as f64;
+    println!("named mutex acquire and release, uncontended: {each:.3} us a pair over {rounds} rounds");
+}
diff --git a/crates/collide/src/run.rs b/crates/collide/src/run.rs
new file mode 100644
index 00000000..245efae6
--- /dev/null
+++ b/crates/collide/src/run.rs
@@ -0,0 +1,421 @@
+//! The orchestrator: runs a script of steps against server and client
+//! processes, printing every line they print, tagged, in arrival order.
+//!
+//! Steps, one per line (`#` starts a comment; `${NAME}` is replaced by an
+//! environment variable, `$HWND` and `$HWND2` by the first and second
+//! window a server announced):
+//! - `spawn <tag> <collide arguments...>`
+//! - `send <tag> <line>`
+//! - `wait <tag> <prefix> [timeout ms]`: until that process prints a line
+//!   whose text starts with the prefix; a timeout is reported, not fatal
+//! - `sleep <ms>` (fractions allowed; spins for precision)
+
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::mpsc::{Receiver, Sender, channel};
+use std::time::{Duration, Instant};
+
+use crate::{now_us, tod};
+
+struct World {
+    tx: Sender<(String, String)>,
+    rx: Receiver<(String, String)>,
+    children: HashMap<String, (Child, ChildStdin)>,
+    vars: HashMap<String, String>,
+    hwnds: usize,
+    /// The console started by `console`: its job (killing conhost and
+    /// cmd.exe when closed) and conhost's process handle.
+    console: Option<(isize, isize)>,
+    /// e38: every line received so far, so that a wait also finds a line
+    /// an earlier wait passed over.
+    seen: Vec<(String, String)>,
+}
+
+impl World {
+    fn spawn(&mut self, tag: &str, args: &[String]) {
+        let exe = std::env::current_exe().unwrap();
+        self.spawn_exe(tag, exe.to_str().unwrap(), args);
+    }
+
+    fn spawn_exe(&mut self, tag: &str, exe: &str, args: &[String]) {
+        let mut child = Command::new(exe)
+            .args(args)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let stdin = child.stdin.take().unwrap();
+        let stdout = child.stdout.take().unwrap();
+        let tx = self.tx.clone();
+        let owned = tag.to_owned();
+        std::thread::spawn(move || {
+            for line in BufReader::new(stdout).lines() {
+                let Ok(line) = line else { break };
+                if tx.send((owned.clone(), line)).is_err() {
+                    break;
+                }
+            }
+        });
+        println!("{} run spawn {tag} {}", tod(now_us()), args.join(" "));
+        self.children.insert(tag.to_owned(), (child, stdin));
+    }
+
+    fn send(&mut self, tag: &str, line: &str) {
+        println!("{} run send {tag} {line}", tod(now_us()));
+        let (_, stdin) = self.children.get_mut(tag).unwrap();
+        writeln!(stdin, "{line}").unwrap();
+        stdin.flush().unwrap();
+    }
+
+    fn note(&mut self, tag: &str, line: &str) {
+        println!("{tag:>3} {line}");
+        if let Some(rest) = line.split_once(' ').map(|(_, r)| r)
+            && let Some(hwnd) = rest.strip_prefix("hwnd ")
+        {
+            let value = hwnd.split_whitespace().next().unwrap().to_owned();
+            self.hwnds += 1;
+            let name = if self.hwnds == 1 {
+                "HWND".to_owned()
+            } else {
+                format!("HWND{}", self.hwnds)
+            };
+            self.vars.insert(name, value);
+        }
+    }
+
+    fn wait(&mut self, tag: &str, prefix: &str, timeout: Duration) -> bool {
+        if let Some(i) = self.seen.iter().position(|(from, line)| {
+            let text = line.split_once(' ').map_or("", |(_, r)| r);
+            from == tag && (text.starts_with(prefix) || line.starts_with(prefix))
+        }) {
+            self.seen.remove(i);
+            return true;
+        }
+        let deadline = Instant::now() + timeout;
+        loop {
+            let left = deadline.saturating_duration_since(Instant::now());
+            match self.rx.recv_timeout(left) {
+                Ok((from, line)) => {
+                    self.note(&from, &line);
+                    let text = line.split_once(' ').map_or("", |(_, r)| r);
+                    if from == tag && (text.starts_with(prefix) || line.starts_with(prefix)) {
+                        return true;
+                    }
+                    self.seen.push((from, line));
+                }
+                Err(_) => {
+                    println!("{} run timeout waiting {tag} {prefix}", tod(now_us()));
+                    return false;
+                }
+            }
+        }
+    }
+
+    fn drain(&mut self, quiet: Duration) {
+        while let Ok((from, line)) = self.rx.recv_timeout(quiet) {
+            self.note(&from, &line);
+        }
+    }
+
+    fn expand_env(&self, text: &str) -> String {
+        let mut out = text.to_owned();
+        while let Some(start) = out.find("${") {
+            let end = out[start..].find('}').unwrap() + start;
+            let name = &out[start + 2..end];
+            let value = std::env::var(name).unwrap_or_default();
+            out.replace_range(start..=end, &value);
+        }
+        out
+    }
+
+    fn expand(&self, text: &str) -> String {
+        let mut out = text.to_owned();
+        let mut names: Vec<&String> = self.vars.keys().collect();
+        names.sort_by_key(|n| std::cmp::Reverse(n.len()));
+        for name in names {
+            out = out.replace(&format!("${name}"), &self.vars[name]);
+        }
+        out
+    }
+}
+
+pub fn main(args: &[String]) {
+    let script = std::fs::read_to_string(&args[0]).unwrap();
+    let (tx, rx) = channel();
+    let mut world = World {
+        tx,
+        rx,
+        children: HashMap::new(),
+        vars: HashMap::new(),
+        hwnds: 0,
+        console: None,
+        seen: Vec::new(),
+    };
+    for raw in script.lines() {
+        let raw = raw.split('#').next().unwrap().trim();
+        if raw.is_empty() {
+            continue;
+        }
+        let expanded = world.expand_env(raw);
+        for line in expanded.split('|').map(str::trim).filter(|l| !l.is_empty()) {
+        let line = world.expand(line);
+        let words: Vec<String> = line.split_whitespace().map(str::to_owned).collect();
+        match words[0].as_str() {
+            "spawn" => world.spawn(&words[1], &words[2..]),
+            "spawnexe" => world.spawn_exe(&words[1], &words[2], &words[3..]),
+            "findwindow" => {
+                let title: Vec<u16> = words[1].encode_utf16().chain(Some(0)).collect();
+                // SAFETY: a valid title.
+                let hwnd = unsafe {
+                    windows::Win32::UI::WindowsAndMessaging::FindWindowW(
+                        None,
+                        windows::core::PCWSTR(title.as_ptr()),
+                    )
+                }
+                .unwrap();
+                let line = format!("{} hwnd {} found", tod(now_us()), hwnd.0 as isize);
+                world.note("run", &line);
+            }
+            "owner" => {
+                // The process and thread that own a window.
+                let hwnd = windows::Win32::Foundation::HWND(words[1].parse::<isize>().unwrap() as *mut std::ffi::c_void);
+                let mut pid = 0u32;
+                // SAFETY: any window handle is tolerated.
+                let tid = unsafe { windows::Win32::UI::WindowsAndMessaging::GetWindowThreadProcessId(hwnd, Some(&raw mut pid)) };
+                let line = format!("{} owner hwnd={} pid={pid} tid={tid}", tod(now_us()), words[1]);
+                world.note("run", &line);
+            }
+            "stall" => {
+                // Suspends the thread that owns a window for some ms, so
+                // that sent messages and calls to it wait, as for a busy
+                // UI thread; resumed from another thread.
+                use windows::Win32::System::Threading::{OpenThread, ResumeThread, SuspendThread, THREAD_SUSPEND_RESUME};
+                // `tid:<n>` names the thread itself: a console window reports
+                // its client's process and thread, not conhost's window thread.
+                let ms: u64 = words[2].parse().unwrap();
+                let tid = if let Some(tid) = words[1].strip_prefix("tid:") {
+                    tid.parse().unwrap()
+                } else {
+                    let hwnd = windows::Win32::Foundation::HWND(words[1].parse::<isize>().unwrap() as *mut std::ffi::c_void);
+                    // SAFETY: any window handle is tolerated.
+                    unsafe { windows::Win32::UI::WindowsAndMessaging::GetWindowThreadProcessId(hwnd, None) }
+                };
+                // SAFETY: a thread id just read.
+                let thread = unsafe { OpenThread(THREAD_SUSPEND_RESUME, false, tid) }.unwrap();
+                // SAFETY: a handle with suspend access.
+                let count = unsafe { SuspendThread(thread) };
+                let line = format!("{} stall-begin tid={tid} count={count}", tod(now_us()));
+                world.note("run", &line);
+                let raw = thread.0 as isize;
+                let tx = world.tx.clone();
+                std::thread::spawn(move || {
+                    std::thread::sleep(Duration::from_millis(ms));
+                    let thread = windows::Win32::Foundation::HANDLE(raw as *mut std::ffi::c_void);
+                    // SAFETY: the handle opened above.
+                    let count = unsafe { ResumeThread(thread) };
+                    // SAFETY: the handle opened above, closed once.
+                    let _ = unsafe { windows::Win32::Foundation::CloseHandle(thread) };
+                    let _ = tx.send(("run".into(), format!("{} stall-end count={count}", tod(now_us()))));
+                });
+            }
+            "send" => {
+                let rest = line.splitn(3, ' ').nth(2).unwrap_or("").to_owned();
+                world.send(&words[1], &rest);
+            }
+            "wait" => {
+                // The prefix is every word after the tag, except a final
+                // number, which is the timeout.
+                let (timeout, prefix) = match words.last().unwrap().parse::<u64>() {
+                    Ok(t) if words.len() > 3 => (t, words[2..words.len() - 1].join(" ")),
+                    _ => (10_000, words[2..].join(" ")),
+                };
+                world.wait(&words[1], &prefix, Duration::from_millis(timeout));
+            }
+            "sleep" => {
+                let ms: f64 = words[1].parse().unwrap();
+                #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+                let until = now_us() + (ms * 1000.0) as u64;
+                if ms > 20.0 {
+                    std::thread::sleep(Duration::from_secs_f64((ms - 15.0) / 1000.0));
+                }
+                while now_us() < until {
+                    std::hint::spin_loop();
+                }
+            }
+            "console" => {
+                // e37: starts conhost.exe running cmd.exe, titled words[1]
+                // (lpTitle, no standard handles, as the e2e agent launches
+                // a console), in a job that kills both when closed, then
+                // spins on FindWindowW until the console window exists.
+                use windows::Win32::System::JobObjects::{
+                    AssignProcessToJobObject, CreateJobObjectW, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE,
+                    JOBOBJECT_EXTENDED_LIMIT_INFORMATION, JobObjectExtendedLimitInformation,
+                    SetInformationJobObject,
+                };
+                use windows::Win32::System::Threading::{
+                    CREATE_SUSPENDED, CreateProcessW, PROCESS_INFORMATION, ResumeThread, STARTUPINFOW,
+                };
+                use windows::Win32::UI::WindowsAndMessaging::{FindWindowW, IsWindowVisible};
+                use windows::core::{PCWSTR, PWSTR, w};
+                let mut title: Vec<u16> = words[1].encode_utf16().chain(Some(0)).collect();
+                let mut command: Vec<u16> = "conhost.exe cmd.exe /d /k".encode_utf16().chain(Some(0)).collect();
+                // SAFETY: plain job calls on a handle just created.
+                let job = unsafe {
+                    let job = CreateJobObjectW(None, PCWSTR::null()).unwrap();
+                    let mut limits = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
+                    limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+                    SetInformationJobObject(
+                        job,
+                        JobObjectExtendedLimitInformation,
+                        (&raw const limits).cast(),
+                        u32::try_from(size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>()).unwrap(),
+                    )
+                    .unwrap();
+                    job
+                };
+                let startup = STARTUPINFOW {
+                    cb: u32::try_from(size_of::<STARTUPINFOW>()).unwrap(),
+                    lpTitle: PWSTR(title.as_mut_ptr()),
+                    ..Default::default()
+                };
+                let mut info = PROCESS_INFORMATION::default();
+                // SAFETY: writable, nul-terminated buffers that outlive the call.
+                unsafe {
+                    CreateProcessW(
+                        PCWSTR::null(),
+                        Some(PWSTR(command.as_mut_ptr())),
+                        None,
+                        None,
+                        false,
+                        CREATE_SUSPENDED,
+                        None,
+                        PCWSTR::null(),
+                        &raw const startup,
+                        &raw mut info,
+                    )
+                    .unwrap();
+                    AssignProcessToJobObject(job, info.hProcess).unwrap();
+                }
+                let launched = now_us();
+                // SAFETY: the suspended thread just created.
+                unsafe { ResumeThread(info.hThread) };
+                let hwnd = loop {
+                    // SAFETY: a valid class and title.
+                    if let Ok(hwnd) = unsafe { FindWindowW(w!("ConsoleWindowClass"), PCWSTR(title.as_ptr())) } {
+                        break hwnd;
+                    }
+                    assert!(now_us() - launched < 10_000_000, "no console window");
+                };
+                let found = now_us();
+                // SAFETY: any window handle is tolerated.
+                let visible = unsafe { IsWindowVisible(hwnd) }.as_bool();
+                #[allow(clippy::cast_precision_loss)]
+                let line = format!(
+                    "{} hwnd {} found console conhost-pid={} launched={} after-launch-ms={:.1} visible={visible}",
+                    tod(found),
+                    hwnd.0 as isize,
+                    info.dwProcessId,
+                    tod(launched),
+                    (found - launched) as f64 / 1000.0
+                );
+                world.note("run", &line);
+                let conpid = if world.hwnds == 1 { "CONPID".to_owned() } else { format!("CONPID{}", world.hwnds) };
+                world.vars.insert(conpid, info.dwProcessId.to_string());
+                // e38: when the window becomes visible and the foreground
+                // window, polled every millisecond for 3 s.
+                {
+                    let raw = hwnd.0 as isize;
+                    let tx = world.tx.clone();
+                    std::thread::spawn(move || {
+                        use windows::Win32::UI::WindowsAndMessaging::GetForegroundWindow;
+                        let hwnd = windows::Win32::Foundation::HWND(raw as *mut std::ffi::c_void);
+                        let (mut vis, mut fg) = (false, false);
+                        while now_us() - found < 3_000_000 && !(vis && fg) {
+                            // SAFETY: any window handle is tolerated.
+                            if !vis && unsafe { IsWindowVisible(hwnd) }.as_bool() {
+                                vis = true;
+                                #[allow(clippy::cast_precision_loss)]
+                                let _ = tx.send(("run".into(), format!("{} console-visible after-found-ms={:.1}", tod(now_us()), (now_us() - found) as f64 / 1000.0)));
+                            }
+                            // SAFETY: no preconditions.
+                            if !fg && unsafe { GetForegroundWindow() } == hwnd {
+                                fg = true;
+                                #[allow(clippy::cast_precision_loss)]
+                                let _ = tx.send(("run".into(), format!("{} console-foreground after-found-ms={:.1}", tod(now_us()), (now_us() - found) as f64 / 1000.0)));
+                            }
+                            std::thread::sleep(Duration::from_millis(1));
+                        }
+                    });
+                }
+                // SAFETY: the thread handle is not used again.
+                let _ = unsafe { windows::Win32::Foundation::CloseHandle(info.hThread) };
+                world.console = Some((job.0 as isize, info.hProcess.0 as isize));
+            }
+            "fgright" => {
+                // e38: injects a zero mouse move, so that this process sent
+                // the last input and may set (and allow) the foreground, as
+                // the e2e agent may; then allows any process to take it.
+                use windows::Win32::UI::Input::KeyboardAndMouse::{
+                    INPUT, INPUT_0, INPUT_MOUSE, MOUSEEVENTF_MOVE, MOUSEINPUT, SendInput,
+                };
+                use windows::Win32::UI::WindowsAndMessaging::{ASFW_ANY, AllowSetForegroundWindow};
+                let input = INPUT {
+                    r#type: INPUT_MOUSE,
+                    Anonymous: INPUT_0 {
+                        mi: MOUSEINPUT { dx: 0, dy: 0, dwFlags: MOUSEEVENTF_MOVE, ..Default::default() },
+                    },
+                };
+                // SAFETY: one well-formed input.
+                let sent = unsafe { SendInput(&[input], i32::try_from(size_of::<INPUT>()).unwrap()) };
+                std::thread::sleep(Duration::from_millis(30));
+                // SAFETY: a plain call.
+                let allowed = unsafe { AllowSetForegroundWindow(ASFW_ANY) }.is_ok();
+                let line = format!("{} fgright sent={sent} allowed={allowed}", tod(now_us()));
+                world.note("run", &line);
+            }
+            "closeconsole" => {
+                // Kills conhost and cmd.exe (closing the job) and waits for
+                // conhost to exit.
+                use windows::Win32::Foundation::{CloseHandle, HANDLE};
+                use windows::Win32::System::Threading::WaitForSingleObject;
+                if let Some((job, process)) = world.console.take() {
+                    let job = HANDLE(job as *mut std::ffi::c_void);
+                    let process = HANDLE(process as *mut std::ffi::c_void);
+                    // SAFETY: handles opened by `console`, each closed once.
+                    let waited = unsafe {
+                        let _ = CloseHandle(job);
+                        let waited = WaitForSingleObject(process, 5000);
+                        let _ = CloseHandle(process);
+                        waited
+                    };
+                    let line = format!("{} console closed wait={}", tod(now_us()), waited.0);
+                    world.note("run", &line);
+                }
+            }
+            "drain" => {
+                let ms = words.get(1).map_or(300, |t| t.parse::<u64>().unwrap());
+                world.drain(Duration::from_millis(ms));
+            }
+            other => panic!("unknown step {other}"),
+        }
+        }
+    }
+    world.drain(Duration::from_millis(200));
+    let tags: Vec<String> = world.children.keys().cloned().collect();
+    for tag in tags {
+        let _ = world.send_quiet(&tag);
+    }
+    for (_, (mut child, _)) in world.children.drain() {
+        let _ = child.kill();
+        let _ = child.wait();
+    }
+}
+
+impl World {
+    fn send_quiet(&mut self, tag: &str) -> std::io::Result<()> {
+        let (_, stdin) = self.children.get_mut(tag).unwrap();
+        writeln!(stdin, "quit")?;
+        stdin.flush()
+    }
+}
diff --git a/crates/collide/src/server.rs b/crates/collide/src/server.rs
new file mode 100644
index 00000000..317e2a02
--- /dev/null
+++ b/crates/collide/src/server.rs
@@ -0,0 +1,551 @@
+//! A minimal native UIA server: one STA UI thread, windows that answer
+//! every `WM_GETOBJECT` with `UiaReturnRawElementProvider`, a COM message
+//! filter that can hold a modal loop open while it pumps sent messages,
+//! and a cross-apartment call that makes the UI thread wait in COM's
+//! modal loop on demand.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::io::BufRead;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use std::time::Duration;
+
+use windows::Win32::Foundation::{E_NOINTERFACE, HWND, LPARAM, LRESULT, WPARAM};
+use windows::Win32::Media::Audio::{CoRegisterMessageFilter, IMessageFilter, IMessageFilter_Impl};
+use windows::Win32::Media::HTASK;
+use windows::Win32::System::Com::{
+    CLSCTX_INPROC_SERVER, COINIT_APARTMENTTHREADED, COINIT_MULTITHREADED, CoCreateInstance,
+    CoInitializeEx, IGlobalInterfaceTable, INTERFACEINFO, IServiceProvider, IServiceProvider_Impl,
+};
+use windows::Win32::System::LibraryLoader::GetModuleHandleW;
+use windows::Win32::System::Threading::GetCurrentProcessId;
+use windows::Win32::System::Variant::VARIANT;
+use windows::Win32::UI::Accessibility::{
+    IRawElementProviderSimple, IRawElementProviderSimple_Impl, ProviderOptions,
+    ProviderOptions_ServerSideProvider, ProviderOptions_UseComThreading, UIA_ControlTypePropertyId,
+    UIA_NamePropertyId, UIA_PATTERN_ID, UIA_PROPERTY_ID, UIA_PaneControlTypeId,
+    UiaHostProviderFromHwnd, UiaReturnRawElementProvider, UiaRootObjectId,
+};
+use windows::Win32::UI::WindowsAndMessaging::{
+    CW_USEDEFAULT, CreateWindowExW, DefWindowProcW, DispatchMessageW, GetMessageW, InSendMessageEx,
+    MSG, MSG_WAIT_FOR_MULTIPLE_OBJECTS_EX_FLAGS, MsgWaitForMultipleObjectsEx, PM_NOREMOVE,
+    PM_QS_SENDMESSAGE, PeekMessageW, PostMessageW, PostQuitMessage, QS_SENDMESSAGE, RegisterClassW,
+    SW_SHOW, SetForegroundWindow, ShowWindow, TranslateMessage, WINDOW_EX_STYLE, WM_APP,
+    WM_GETOBJECT, WNDCLASSW, WS_OVERLAPPEDWINDOW,
+};
+use windows::core::{BSTR, Error, GUID, IUnknown, Interface, PCWSTR, Result, implement, w};
+
+use crate::{now_us, say};
+
+const WM_LINE: u32 = WM_APP + 1;
+const WM_POKE: u32 = WM_APP + 2;
+
+/// The armed hold: (longest, linger after a `WM_GETOBJECT` ends), in ms.
+static HOLD: Mutex<Option<(u64, u64)>> = Mutex::new(None);
+static PROVIDER_HOLD: Mutex<Option<(u64, u64)>> = Mutex::new(None);
+static IN_HOLD: AtomicBool = AtomicBool::new(false);
+static RELEASE: AtomicBool = AtomicBool::new(false);
+static GETOBJECT_DONE: AtomicU64 = AtomicU64::new(0);
+static POKE: AtomicBool = AtomicBool::new(false);
+static POKE_TARGETS: Mutex<Vec<isize>> = Mutex::new(Vec::new());
+static SLOW_MS: AtomicU32 = AtomicU32::new(0);
+static FILTER: AtomicBool = AtomicBool::new(false);
+static DETECT_ALL: AtomicBool = AtomicBool::new(false);
+static ONLY_ROOT: AtomicBool = AtomicBool::new(false);
+static NO_UIA: AtomicBool = AtomicBool::new(false);
+static PENDING_LOG: AtomicBool = AtomicBool::new(true);
+static MAIN: std::sync::atomic::AtomicIsize = std::sync::atomic::AtomicIsize::new(0);
+
+thread_local! {
+    static PROVIDERS: RefCell<HashMap<isize, IRawElementProviderSimple>> = RefCell::new(HashMap::new());
+    static SLOW: RefCell<Option<IServiceProvider>> = const { RefCell::new(None) };
+}
+
+#[implement(IRawElementProviderSimple)]
+struct Provider {
+    hwnd: isize,
+}
+
+impl IRawElementProviderSimple_Impl for Provider_Impl {
+    fn ProviderOptions(&self) -> Result<ProviderOptions> {
+        Ok(ProviderOptions(
+            ProviderOptions_ServerSideProvider.0 | ProviderOptions_UseComThreading.0,
+        ))
+    }
+    fn GetPatternProvider(&self, _: UIA_PATTERN_ID) -> Result<IUnknown> {
+        Err(Error::empty())
+    }
+    fn GetPropertyValue(&self, id: UIA_PROPERTY_ID) -> Result<VARIANT> {
+        if id == UIA_NamePropertyId {
+            let armed = PROVIDER_HOLD.lock().unwrap().take();
+            if let Some((longest, linger)) = armed {
+                say("provider-hold");
+                hold(longest, linger);
+            }
+            Ok(VARIANT::from(BSTR::from("uia-provider")))
+        } else if id == UIA_ControlTypePropertyId {
+            Ok(VARIANT::from(UIA_PaneControlTypeId.0))
+        } else {
+            Ok(VARIANT::default())
+        }
+    }
+    fn HostRawElementProvider(&self) -> Result<IRawElementProviderSimple> {
+        // SAFETY: the window is this process's own.
+        unsafe { UiaHostProviderFromHwnd(HWND(self.hwnd as *mut c_void)) }
+    }
+}
+
+#[implement(IMessageFilter)]
+struct Filter;
+
+impl IMessageFilter_Impl for Filter_Impl {
+    fn HandleInComingCall(&self, _: u32, _: HTASK, _: u32, _: *const INTERFACEINFO) -> u32 {
+        0 // SERVERCALL_ISHANDLED
+    }
+    fn RetryRejectedCall(&self, _: HTASK, _: u32, _: u32) -> u32 {
+        u32::MAX // cancel
+    }
+    fn MessagePending(&self, callee: HTASK, tick: u32, pending_type: u32) -> u32 {
+        if DETECT_ALL.load(Ordering::Relaxed) || PENDING_LOG.swap(false, Ordering::Relaxed) {
+            say(&format!(
+                "pending callee={:?} tick={tick} type={pending_type}",
+                callee.0
+            ));
+        }
+        let armed = HOLD.lock().unwrap().take();
+        if let Some((longest, linger)) = armed {
+            hold(longest, linger);
+        }
+        2 // PENDINGMSG_WAITDEFPROCESS
+    }
+}
+
+/// Keeps the modal loop open, dispatching only sent messages, until a
+/// `WM_GETOBJECT` dispatched here has ended `linger` ms ago, `release`
+/// arrives, or `longest` ms have passed.
+fn hold(longest: u64, linger: u64) {
+    GETOBJECT_DONE.store(0, Ordering::SeqCst);
+    RELEASE.store(false, Ordering::SeqCst);
+    IN_HOLD.store(true, Ordering::SeqCst);
+    say("held");
+    let start = now_us();
+    let why = loop {
+        let now = now_us();
+        if now - start > longest * 1000 {
+            break "longest";
+        }
+        if RELEASE.load(Ordering::SeqCst) {
+            break "release";
+        }
+        let done = GETOBJECT_DONE.load(Ordering::SeqCst);
+        if done != 0 && now.saturating_sub(done) >= linger * 1000 {
+            break "after-getobject";
+        }
+        // SAFETY: no handles; wakes for a sent message or after 1 ms.
+        unsafe {
+            MsgWaitForMultipleObjectsEx(
+                None,
+                1,
+                QS_SENDMESSAGE,
+                MSG_WAIT_FOR_MULTIPLE_OBJECTS_EX_FLAGS(0),
+            );
+        }
+        let mut msg = MSG::default();
+        // SAFETY: dispatches pending sent messages only.
+        let _ = unsafe { PeekMessageW(&raw mut msg, None, 0, 0, PM_NOREMOVE | PM_QS_SENDMESSAGE) };
+    };
+    IN_HOLD.store(false, Ordering::SeqCst);
+    POKE.store(false, Ordering::SeqCst);
+    say(&format!("released why={why}"));
+}
+
+#[implement(IServiceProvider, Agile = false)]
+struct Slow;
+
+impl IServiceProvider_Impl for Slow_Impl {
+    fn QueryService(&self, _: *const GUID, _: *const GUID, out: *mut *mut c_void) -> Result<()> {
+        std::thread::sleep(Duration::from_millis(u64::from(SLOW_MS.load(Ordering::SeqCst))));
+        if !out.is_null() {
+            // SAFETY: the caller's out pointer.
+            unsafe { *out = std::ptr::null_mut() };
+        }
+        Err(E_NOINTERFACE.into())
+    }
+}
+
+/// An object in this process's MTA, called through a proxy from the STA.
+fn make_slow() -> IServiceProvider {
+    const GIT: GUID = GUID::from_u128(0x00000323_0000_0000_c000_000000000046);
+    let (tx, rx) = std::sync::mpsc::channel::<u32>();
+    std::thread::spawn(move || {
+        // SAFETY: this thread's own initialization.
+        unsafe { CoInitializeEx(None, COINIT_MULTITHREADED) }.ok().unwrap();
+        let slow: IServiceProvider = Slow.into();
+        // SAFETY: the system's global interface table.
+        let git: IGlobalInterfaceTable = unsafe { CoCreateInstance(&GIT, None, CLSCTX_INPROC_SERVER) }.unwrap();
+        // SAFETY: a live interface.
+        let cookie = unsafe { git.RegisterInterfaceInGlobal(&slow, &IServiceProvider::IID) }.unwrap();
+        tx.send(cookie).unwrap();
+        loop {
+            std::thread::park();
+        }
+    });
+    let cookie = rx.recv().unwrap();
+    // SAFETY: the system's global interface table.
+    let git: IGlobalInterfaceTable = unsafe { CoCreateInstance(&GIT, None, CLSCTX_INPROC_SERVER) }.unwrap();
+    let mut raw = std::ptr::null_mut();
+    // SAFETY: a registered cookie and a valid out pointer.
+    unsafe { git.GetInterfaceFromGlobal(cookie, &IServiceProvider::IID, &raw mut raw) }.unwrap();
+    // SAFETY: the reference the call returned.
+    unsafe { IServiceProvider::from_raw(raw) }
+}
+
+fn register() {
+    let class = WNDCLASSW {
+        lpfnWndProc: Some(wnd_proc),
+        // SAFETY: this module.
+        hInstance: unsafe { GetModuleHandleW(None) }.unwrap().into(),
+        lpszClassName: w!("CollideServer"),
+        ..Default::default()
+    };
+    // SAFETY: a valid class.
+    unsafe { RegisterClassW(&raw const class) };
+}
+
+fn create(title: &str, show: bool) -> HWND {
+    let wide: Vec<u16> = title.encode_utf16().chain(Some(0)).collect();
+    // SAFETY: a registered class and a valid title.
+    let hwnd = unsafe {
+        CreateWindowExW(
+            WINDOW_EX_STYLE(0),
+            w!("CollideServer"),
+            PCWSTR(wide.as_ptr()),
+            WS_OVERLAPPEDWINDOW,
+            CW_USEDEFAULT,
+            CW_USEDEFAULT,
+            400,
+            300,
+            None,
+            None,
+            None,
+            None,
+        )
+    }
+    .unwrap();
+    if show {
+        // SAFETY: our window.
+        unsafe {
+            let _ = ShowWindow(hwnd, SW_SHOW);
+        }
+        // SAFETY: plain calls; the input attachment is undone at once.
+        unsafe {
+            let foreground = windows::Win32::UI::WindowsAndMessaging::GetForegroundWindow();
+            let theirs = windows::Win32::UI::WindowsAndMessaging::GetWindowThreadProcessId(foreground, None);
+            let ours = windows::Win32::System::Threading::GetCurrentThreadId();
+            let _ = windows::Win32::System::Threading::AttachThreadInput(ours, theirs, true);
+            let _ = SetForegroundWindow(hwnd);
+            let _ = windows::Win32::UI::Input::KeyboardAndMouse::SetFocus(Some(hwnd));
+            let _ = windows::Win32::System::Threading::AttachThreadInput(ours, theirs, false);
+        }
+    }
+    say(&format!("hwnd {} pid {}", hwnd.0 as isize, unsafe {
+        GetCurrentProcessId()
+    }));
+    hwnd
+}
+
+/// A child window with a provider of its own, under `parent`, which may be
+/// another process's window.
+fn create_child(title: &str, parent: isize) -> HWND {
+    let wide: Vec<u16> = title.encode_utf16().chain(Some(0)).collect();
+    // SAFETY: a registered class, a valid title and a live parent.
+    let hwnd = unsafe {
+        CreateWindowExW(
+            WINDOW_EX_STYLE(0),
+            w!("CollideServer"),
+            PCWSTR(wide.as_ptr()),
+            windows::Win32::UI::WindowsAndMessaging::WS_CHILD
+                | windows::Win32::UI::WindowsAndMessaging::WS_VISIBLE,
+            0,
+            0,
+            100,
+            100,
+            Some(HWND(parent as *mut c_void)),
+            None,
+            None,
+            None,
+        )
+    }
+    .unwrap();
+    say(&format!("hwnd {} pid {} child-of {parent}", hwnd.0 as isize, unsafe {
+        GetCurrentProcessId()
+    }));
+    hwnd
+}
+
+pub fn main(args: &[String]) {
+    let filter = args.iter().any(|a| a == "--filter");
+    let show = args.iter().any(|a| a == "--show");
+    ONLY_ROOT.store(args.iter().any(|a| a == "--only-root"), Ordering::SeqCst);
+    NO_UIA.store(args.iter().any(|a| a == "--no-uia"), Ordering::SeqCst);
+    // SAFETY: this thread's own initialization.
+    unsafe { CoInitializeEx(None, COINIT_APARTMENTTHREADED) }.ok().unwrap();
+    FILTER.store(filter, Ordering::SeqCst);
+    if filter {
+        let filter: IMessageFilter = Filter.into();
+        // SAFETY: a live filter.
+        unsafe { CoRegisterMessageFilter(&filter, None) }.unwrap();
+    }
+    SLOW.with(|s| *s.borrow_mut() = Some(make_slow()));
+    register();
+    let hwnd = create("collide", show);
+    let target = hwnd.0 as isize;
+    MAIN.store(target, Ordering::SeqCst);
+    std::thread::spawn(move || {
+        for line in std::io::stdin().lock().lines() {
+            let Ok(line) = line else { break };
+            let line = line.trim().to_owned();
+            match line.as_str() {
+                "release" => RELEASE.store(true, Ordering::SeqCst),
+                "poke on" => POKE.store(true, Ordering::SeqCst),
+                "poke off" => POKE.store(false, Ordering::SeqCst),
+                _ => {
+                    let raw = Box::into_raw(Box::new(line)) as isize;
+                    // SAFETY: the window procedure takes the box back.
+                    unsafe {
+                        let _ = PostMessageW(
+                            Some(HWND(target as *mut c_void)),
+                            WM_LINE,
+                            WPARAM(0),
+                            LPARAM(raw),
+                        );
+                    }
+                }
+            }
+        }
+    });
+    POKE_TARGETS.lock().unwrap().push(target);
+    std::thread::spawn(move || {
+        loop {
+            if POKE.load(Ordering::SeqCst) {
+                for &window in POKE_TARGETS.lock().unwrap().iter() {
+                    // SAFETY: a posted message to our window.
+                    unsafe {
+                        let _ = PostMessageW(
+                            Some(HWND(window as *mut c_void)),
+                            WM_POKE,
+                            WPARAM(0),
+                            LPARAM(0),
+                        );
+                    }
+                }
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    });
+    say("ready");
+    let mut msg = MSG::default();
+    // SAFETY: the standard loop.
+    while unsafe { GetMessageW(&raw mut msg, None, 0, 0) }.as_bool() {
+        // SAFETY: the message just read.
+        unsafe {
+            let _ = TranslateMessage(&raw const msg);
+            DispatchMessageW(&raw const msg);
+        }
+    }
+}
+
+fn command(line: &str) {
+    let words: Vec<&str> = line.split_whitespace().collect();
+    match words.as_slice() {
+        ["arm", longest, linger] => {
+            *HOLD.lock().unwrap() = Some((longest.parse().unwrap(), linger.parse().unwrap()));
+            PENDING_LOG.store(true, Ordering::SeqCst);
+            POKE.store(true, Ordering::SeqCst);
+            say("armed");
+        }
+        ["armprov", longest, linger] => {
+            *PROVIDER_HOLD.lock().unwrap() =
+                Some((longest.parse().unwrap(), linger.parse().unwrap()));
+            say("armed");
+        }
+        ["disarm"] => {
+            let was = HOLD.lock().unwrap().take();
+            POKE.store(false, Ordering::SeqCst);
+            say(&format!("disarmed was_armed={}", was.is_some()));
+        }
+        ["detectall"] => {
+            DETECT_ALL.store(true, Ordering::SeqCst);
+            POKE.store(true, Ordering::SeqCst);
+            say("detecting");
+        }
+        ["detect"] => {
+            PENDING_LOG.store(true, Ordering::SeqCst);
+            say("detecting");
+        }
+        ["modal", ms] => {
+            SLOW_MS.store(ms.parse().unwrap(), Ordering::SeqCst);
+            let slow = SLOW.with(|s| s.borrow().clone()).unwrap();
+            say("modal-begin");
+            // SAFETY: a live proxy; the result is ignored.
+            let result = unsafe { slow.QueryService::<IUnknown>(&GUID::zeroed()) }.map(|_| ());
+            say(&format!("modal-end {result:?}"));
+        }
+        ["activate"] => {
+            // CLSID_ShellWindows, served out of process by File Explorer.
+            const SHELL_WINDOWS: GUID = GUID::from_u128(0x9ba05972_f6a8_11cf_a442_00a0c90a8f39);
+            say("activate-begin");
+            // SAFETY: an activation whose result is dropped.
+            let result = unsafe {
+                CoCreateInstance::<_, IUnknown>(&SHELL_WINDOWS, None, windows::Win32::System::Com::CLSCTX_LOCAL_SERVER)
+            };
+            say(&format!("activate-end ok={}", result.is_ok()));
+        }
+        ["newwindow"] => {
+            create("collide-2", false);
+        }
+        ["child"] => {
+            create_child("collide-child", MAIN.load(Ordering::SeqCst));
+        }
+        ["showtopoff"] => {
+            // As showoff, but topmost, so a walk of the desktop's children
+            // reaches it among the first.
+            use windows::Win32::UI::WindowsAndMessaging::{
+                HWND_TOPMOST, SWP_NOACTIVATE, SWP_SHOWWINDOW, SetWindowPos,
+            };
+            // SAFETY: our window.
+            let _ = unsafe {
+                SetWindowPos(
+                    HWND(MAIN.load(Ordering::SeqCst) as *mut c_void),
+                    Some(HWND_TOPMOST),
+                    -3000,
+                    -3000,
+                    400,
+                    300,
+                    SWP_NOACTIVATE | SWP_SHOWWINDOW,
+                )
+            };
+            say("shown-off-screen");
+        }
+        ["showoff"] => {
+            // Visible, so its child windows are in UIA's tree, but off every
+            // monitor, at the bottom of the order, and never activated.
+            use windows::Win32::UI::WindowsAndMessaging::{
+                HWND_BOTTOM, SWP_NOACTIVATE, SWP_SHOWWINDOW, SetWindowPos,
+            };
+            // SAFETY: our window.
+            let _ = unsafe {
+                SetWindowPos(
+                    HWND(MAIN.load(Ordering::SeqCst) as *mut c_void),
+                    Some(HWND_BOTTOM),
+                    -3000,
+                    -3000,
+                    400,
+                    300,
+                    SWP_NOACTIVATE | SWP_SHOWWINDOW,
+                )
+            };
+            say("shown-off-screen");
+        }
+        ["childof", parent] => {
+            create_child("collide-child", parent.parse().unwrap());
+        }
+        ["newthread"] => {
+            let filter = FILTER.load(Ordering::SeqCst);
+            std::thread::spawn(move || {
+                // SAFETY: this thread's own initialization.
+                unsafe { CoInitializeEx(None, COINIT_APARTMENTTHREADED) }.ok().unwrap();
+                if filter {
+                    let filter: IMessageFilter = Filter.into();
+                    // SAFETY: a live filter.
+                    unsafe { CoRegisterMessageFilter(&filter, None) }.unwrap();
+                }
+                let hwnd = create("collide-thread", false);
+                POKE_TARGETS.lock().unwrap().push(hwnd.0 as isize);
+                let mut msg = MSG::default();
+                // SAFETY: the standard loop.
+                while unsafe { GetMessageW(&raw mut msg, None, 0, 0) }.as_bool() {
+                    // SAFETY: the message just read.
+                    unsafe {
+                        let _ = TranslateMessage(&raw const msg);
+                        DispatchMessageW(&raw const msg);
+                    }
+                }
+            });
+        }
+        ["busy", ms] => {
+            // The UI thread works without pumping, as an application busy
+            // with layout or rendering: sent and posted messages wait.
+            let ms: u64 = ms.parse().unwrap();
+            say("busy-begin");
+            let until = now_us() + ms * 1000;
+            while now_us() < until {
+                std::hint::spin_loop();
+            }
+            say("busy-end");
+        }
+        ["quit"] => {
+            // SAFETY: ends this thread's loop.
+            unsafe { PostQuitMessage(0) };
+        }
+        _ => say(&format!("unknown {line}")),
+    }
+}
+
+unsafe extern "system" fn wnd_proc(hwnd: HWND, msg: u32, wparam: WPARAM, lparam: LPARAM) -> LRESULT {
+    match msg {
+        WM_GETOBJECT => {
+            #[allow(clippy::cast_possible_truncation)]
+            let objid = lparam.0 as i32;
+            // SAFETY: no preconditions.
+            let in_send = unsafe { InSendMessageEx(None) };
+            let held = IN_HOLD.load(Ordering::SeqCst);
+            let start = now_us();
+            say(&format!(
+                "getobject-begin hwnd={} objid={objid} wparam={:#x} insend={in_send:#x} in_hold={held}",
+                hwnd.0 as isize, wparam.0
+            ));
+            let result = if NO_UIA.load(Ordering::SeqCst)
+                || (ONLY_ROOT.load(Ordering::SeqCst) && objid != UiaRootObjectId)
+            {
+                // SAFETY: default handling.
+                unsafe { DefWindowProcW(hwnd, msg, wparam, lparam) }
+            } else {
+                let provider = PROVIDERS.with(|p| {
+                    p.borrow_mut()
+                        .entry(hwnd.0 as isize)
+                        .or_insert_with(|| {
+                            Provider {
+                                hwnd: hwnd.0 as isize,
+                            }
+                            .into()
+                        })
+                        .clone()
+                });
+                // SAFETY: a live provider for our window.
+                unsafe { UiaReturnRawElementProvider(hwnd, wparam, lparam, &provider) }
+            };
+            say(&format!(
+                "getobject-end hwnd={} objid={objid} lresult={:#x} us={} in_hold={held}",
+                hwnd.0 as isize,
+                result.0,
+                now_us() - start
+            ));
+            if held {
+                GETOBJECT_DONE.store(now_us(), Ordering::SeqCst);
+            }
+            result
+        }
+        WM_LINE => {
+            // SAFETY: the stdin thread's box.
+            let line = unsafe { Box::from_raw(lparam.0 as *mut String) };
+            command(&line);
+            LRESULT(0)
+        }
+        WM_POKE => LRESULT(0),
+        // SAFETY: default handling.
+        _ => unsafe { DefWindowProcW(hwnd, msg, wparam, lparam) },
+    }
+}
