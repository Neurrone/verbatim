+        let mut changed_entries = 0;
+        for index in 0..count {
+            let entry = unsafe { m.GetEntry(index) }.unwrap();
+            let mut changed = false;
+            for &(ev, prop) in &pairs {
+                let arr = unsafe { entry.GetWinEventsForAutomationEvent(ev, prop) }.unwrap();
+                let nonempty = !arr.is_null() && unsafe {
+                    let lo = SafeArrayGetLBound(arr, 1).unwrap_or(0);
+                    let hi = SafeArrayGetUBound(arr, 1).unwrap_or(-1);
+                    hi >= lo
+                };
+                if !arr.is_null() { let _ = unsafe { SafeArrayDestroy(arr) }; }
+                if !nonempty { continue; }
+                unsafe { entry.SetWinEventsForAutomationEvent(ev, prop, std::ptr::null()) }.unwrap();
+                changed = true;
+            }
+            if changed {
+                unsafe { m.RemoveEntry(index) }.unwrap();
+                unsafe { m.InsertEntry(index, &entry) }.unwrap();
+                changed_entries += 1;
+            }
+        }
+        say(&format!("vbmap: {changed_entries} of {count} entries changed"));
+    }
