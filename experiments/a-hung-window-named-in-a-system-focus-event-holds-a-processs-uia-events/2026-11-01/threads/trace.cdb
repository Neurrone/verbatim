.lines -d
sxe -c ".printf \"=== THREAD-CREATED tid=%x\n\", @$tid; ~.; gc" ct
sxe -c ".printf \"=== THREAD-EXITED tid=%x\n\", @$tid; gc" et

bp ntdll!NtCreateThreadEx ".printf \"=== NtCreateThreadEx from tid=%x\n\", @$tid; kc 25; gc"
