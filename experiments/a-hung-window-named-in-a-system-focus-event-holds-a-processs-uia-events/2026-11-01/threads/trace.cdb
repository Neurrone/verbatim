bp combase!CoCreateInstance ".printf \"=== MARK CoCreateInstance tid=%x\n\", @$tid; gc"



bu uiautomationcore!CUIAutomation::AddFocusChangedEventHandler ".printf \"=== MARK AddFocusChangedEventHandler tid=%x\n\", @$tid; gc"

bu uiautomationcore!CUIAutomation::ElementFromHandle ".printf \"=== MARK ElementFromHandle tid=%x\n\", @$tid; gc"

bu uiautomationcore!CUIAutomation::AddPropertyChangedEventHandlerNativeArray ".printf \"=== MARK AddPropertyChangedEventHandlerNativeArray tid=%x\n\", @$tid; gc"
g
