+++ b/crates/mockapp/src/probe.rs
@@ -0,0 +1,390 @@
+//! `mockapp --focus-probe <log> <pid> <ready>`: an experiment, not part of
+//! mockapp's provider role (scratchpad `focus-pipeline-design.md`, section
+//! 12.11 and the (b2) live check). It holds, in one process, the
+//! desktop-wide UIA focus registration and a focus registration in an event
+//! handler group scoped to each top-level window of process `pid`, and logs
+//! every focus event either one delivers: the route, the time, the sender's
+//! process, runtime id, name, control type and window, its cached and live
+//! `HasKeyboardFocus`. It registers on each new top-level window of `pid` as
+//! it is shown, and logs how long each registration took. It writes `ready`
+//! once its first registrations are in, and runs until it is ended.
+
+use std::ffi::c_void;
+use std::fs::File;
+use std::io::Write;
+use std::sync::mpsc::{self, Sender};
+use std::sync::{Mutex, OnceLock, PoisonError};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use windows::Win32::Foundation::{HWND, LPARAM};
+use windows::Win32::System::Com::{
+    CLSCTX_INPROC_SERVER, COINIT_MULTITHREADED, CoCreateInstance, CoInitializeEx,
+};
+use windows::Win32::System::Ole::{SafeArrayDestroy, SafeArrayGetElement, SafeArrayGetLBound, SafeArrayGetUBound};
+use windows::Win32::UI::Accessibility::{
+    CUIAutomation8, HWINEVENTHOOK, IUIAutomation6, IUIAutomationCacheRequest, IUIAutomationElement,
+    IUIAutomationEventHandler, IUIAutomationEventHandler_Impl,
+    IUIAutomationFocusChangedEventHandler, IUIAutomationFocusChangedEventHandler_Impl,
+    SetWinEventHook, TreeScope_Subtree, UIA_AutomationFocusChangedEventId, UIA_ControlTypePropertyId,
+    UIA_EVENT_ID, UIA_HasKeyboardFocusPropertyId, UIA_NamePropertyId,
+    UIA_NativeWindowHandlePropertyId, UIA_ProcessIdPropertyId, UIA_RuntimeIdPropertyId,
+};
+use windows::Win32::UI::WindowsAndMessaging::{
+    DispatchMessageW, EVENT_OBJECT_FOCUS, EVENT_OBJECT_SHOW, EnumWindows, GA_ROOT, GetAncestor,
+    GetClassNameW, GetMessageW,
+    GetWindowThreadProcessId, IsWindowVisible, MSG, OBJID_WINDOW, WINEVENT_OUTOFCONTEXT,
+};
+use windows::core::BOOL;
+use windows_core::implement;
+
+/// The log, shared by every callback.
+static LOG: OnceLock<Mutex<File>> = OnceLock::new();
+/// New top-level windows of the target, for the registration thread.
+static SHOWN: OnceLock<Mutex<Sender<isize>>> = OnceLock::new();
+/// The target's process id.
+static TARGET: OnceLock<u32> = OnceLock::new();
+
+fn now_us() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |since| since.as_micros())
+}
+
+fn log(line: &str) {
+    if let Some(file) = LOG.get() {
+        let mut file = file.lock().unwrap_or_else(PoisonError::into_inner);
+        let _ = writeln!(file, "{} {line}", now_us());
+        let _ = file.flush();
+    }
+}
+
+fn runtime_id(element: &IUIAutomationElement) -> Vec<i32> {
+    // SAFETY: a live element; the runtime id is read from its cache.
+    let Ok(array) = (unsafe { element.GetRuntimeId() }) else {
+        return Vec::new();
+    };
+    let mut ids = Vec::new();
+    // SAFETY: a one-dimensional array UIA returned.
+    let bounds = unsafe { (SafeArrayGetLBound(array, 1), SafeArrayGetUBound(array, 1)) };
+    if let (Ok(low), Ok(high)) = bounds {
+        for index in low..=high {
+            let mut value = 0i32;
+            // SAFETY: an index within the bounds and an i32 to write.
+            if unsafe { SafeArrayGetElement(array, &raw const index, (&raw mut value).cast::<c_void>()) }
+                .is_ok()
+            {
+                ids.push(value);
+            }
+        }
+    }
+    // SAFETY: the array UIA gave this call to own.
+    let _ = unsafe { SafeArrayDestroy(array) };
+    ids
+}
+
+fn describe(route: &str, element: &IUIAutomationElement) {
+    // SAFETY: cached reads on a live element.
+    let pid = unsafe { element.CachedProcessId() }.unwrap_or(0);
+    // SAFETY: as above.
+    let name = unsafe { element.CachedName() }.map(|name| name.to_string()).unwrap_or_default();
+    // SAFETY: as above.
+    let control_type = unsafe { element.CachedControlType() }.map_or(0, |id| id.0);
+    // SAFETY: as above.
+    let hwnd = unsafe { element.CachedNativeWindowHandle() }.map_or(0, |hwnd| hwnd.0 as isize);
+    // SAFETY: as above.
+    let cached_focus = unsafe { element.CachedHasKeyboardFocus() }.map(BOOL::as_bool);
+    let read = now_us();
+    // SAFETY: a live read on a live element, off the application's thread.
+    let live_focus = unsafe { element.CurrentHasKeyboardFocus() }.map(BOOL::as_bool);
+    let read_us = now_us() - read;
+    log(&format!(
+        "event route={route} pid={pid} target={} rid={:?} name={name:?} type={control_type} hwnd={hwnd} cached_focus={cached_focus:?} live_focus={live_focus:?} live_read_us={read_us}",
+        TARGET.get().is_some_and(|&target| i64::from(pid) == i64::from(target)),
+        runtime_id(element)
+    ));
+}
+
+#[implement(IUIAutomationFocusChangedEventHandler)]
+struct DesktopFocus;
+
+impl IUIAutomationFocusChangedEventHandler_Impl for DesktopFocus_Impl {
+    fn HandleFocusChangedEvent(
+        &self,
+        sender: windows_core::Ref<IUIAutomationElement>,
+    ) -> windows_core::Result<()> {
+        if let Some(element) = sender.as_ref() {
+            describe("desktop", element);
+        }
+        Ok(())
+    }
+}
+
+#[implement(IUIAutomationEventHandler)]
+struct ScopedFocus;
+
+impl IUIAutomationEventHandler_Impl for ScopedFocus_Impl {
+    fn HandleAutomationEvent(
+        &self,
+        sender: windows_core::Ref<IUIAutomationElement>,
+        _event: UIA_EVENT_ID,
+    ) -> windows_core::Result<()> {
+        if let Some(element) = sender.as_ref() {
+            describe("scoped", element);
+        }
+        Ok(())
+    }
+}
+
+unsafe extern "system" fn shown(
+    _hook: HWINEVENTHOOK,
+    event: u32,
+    hwnd: HWND,
+    id_object: i32,
+    id_child: i32,
+    thread: u32,
+    time: u32,
+) {
+    if event == EVENT_OBJECT_FOCUS {
+        let mut class = [0u16; 128];
+        // SAFETY: a local query into a buffer of the given size.
+        let length = unsafe { GetClassNameW(hwnd, &mut class) };
+        let class = String::from_utf16_lossy(&class[..usize::try_from(length).unwrap_or(0)]);
+        let mut pid = 0u32;
+        // SAFETY: a local query with an out-pointer.
+        unsafe { GetWindowThreadProcessId(hwnd, Some(&raw mut pid)) };
+        let mut accessible: Option<windows::Win32::UI::Accessibility::IAccessible> = None;
+        let mut variant = windows::Win32::System::Variant::VARIANT::default();
+        // SAFETY: out-pointers for the object and its child id; this
+        // thread joined COM in `run`.
+        let acquired = unsafe {
+            windows::Win32::UI::Accessibility::AccessibleObjectFromEvent(
+                hwnd,
+                id_object as u32,
+                id_child as u32,
+                &raw mut accessible,
+                &raw mut variant,
+            )
+        };
+        let object = match (acquired, accessible) {
+            (Ok(()), Some(accessible)) => {
+                // SAFETY: cross-process reads on a live object.
+                let name = unsafe { accessible.get_accName(&variant) }.map(|name| name.to_string());
+                // SAFETY: as above.
+                let role = unsafe { accessible.get_accRole(&variant) }
+                    .ok()
+                    .and_then(|role| i32::try_from(&role).ok());
+                format!("msaa_role={role:?} msaa_name={name:?}")
+            }
+            (result, _) => format!("msaa_acquire={result:?}"),
+        };
+        log(&format!(
+            "event route=msaa pid={pid} target={} hwnd={} class={class:?} object={id_object} child={id_child} thread={thread} time={time} {object}",
+            TARGET.get() == Some(&pid),
+            hwnd.0 as isize
+        ));
+        return;
+    }
+    // SAFETY: a local query of a window handle.
+    let root = unsafe { GetAncestor(hwnd, GA_ROOT) };
+    if id_object == OBJID_WINDOW.0 && id_child == 0 && root == hwnd {
+        log(&format!("shown hwnd={}", hwnd.0 as isize));
+        if let Some(sender) = SHOWN.get() {
+            let _ = sender
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+                .send(hwnd.0 as isize);
+        }
+    }
+}
+
+unsafe extern "system" fn collect(hwnd: HWND, windows: LPARAM) -> BOOL {
+    let mut pid = 0u32;
+    // SAFETY: a local query with an out-pointer.
+    unsafe { GetWindowThreadProcessId(hwnd, Some(&raw mut pid)) };
+    // SAFETY: a local query.
+    if Some(&pid) == TARGET.get() && unsafe { IsWindowVisible(hwnd) }.as_bool() {
+        // SAFETY: `windows` is the vector `run` passed, live for the call.
+        unsafe { (*(windows.0 as *mut Vec<isize>)).push(hwnd.0 as isize) };
+    }
+    BOOL(1)
+}
+
+fn register(
+    uia: &IUIAutomation6,
+    cache: &IUIAutomationCacheRequest,
+    handler: &IUIAutomationEventHandler,
+    hwnd: isize,
+) {
+    let started = now_us();
+    // SAFETY: live client, cache and handler; a window handle UIA checks.
+    let result = unsafe {
+        uia.ElementFromHandleBuildCache(HWND(hwnd as *mut c_void), cache)
+            .and_then(|element| {
+                let group = uia.CreateEventHandlerGroup()?;
+                group.AddAutomationEventHandler(
+                    UIA_AutomationFocusChangedEventId,
+                    TreeScope_Subtree,
+                    cache,
+                    handler,
+                )?;
+                uia.AddEventHandlerGroup(&element, &group)
+            })
+    };
+    log(&format!(
+        "registered hwnd={hwnd} took_us={} result={result:?}",
+        now_us() - started
+    ));
+}
+
+/// Clears every proxy factory entry's mapping of WinEvents to focus
+/// changes on `uia`, as `verbatim_uia::proxy` clears the other events',
+/// and logs which entries mapped focus.
+fn clear_focus_mapping(uia: &IUIAutomation6) {
+    use windows::Win32::UI::Accessibility::UIA_PROPERTY_ID;
+    // SAFETY: local calls on a live client.
+    let Ok(mapping) = (unsafe { uia.ProxyFactoryMapping() }) else {
+        log("clear-focus-mapping: no mapping");
+        return;
+    };
+    // SAFETY: as above.
+    let count = unsafe { mapping.Count() }.unwrap_or(0);
+    for index in 0..count {
+        // SAFETY: an index below the count.
+        let Ok(entry) = (unsafe { mapping.GetEntry(index) }) else {
+            continue;
+        };
+        // SAFETY: a local read.
+        let mapped = unsafe {
+            entry.GetWinEventsForAutomationEvent(UIA_AutomationFocusChangedEventId, UIA_PROPERTY_ID(0))
+        };
+        let Ok(array) = mapped else { continue };
+        if array.is_null() {
+            continue;
+        }
+        // SAFETY: owned here.
+        let _ = unsafe { SafeArrayDestroy(array) };
+        // SAFETY: a local read.
+        let class = unsafe { entry.ClassName() }.map(|name| name.to_string()).unwrap_or_default();
+        // SAFETY: a null array maps no WinEvent.
+        let cleared = unsafe {
+            entry.SetWinEventsForAutomationEvent(
+                UIA_AutomationFocusChangedEventId,
+                UIA_PROPERTY_ID(0),
+                std::ptr::null(),
+            )
+        };
+        // SAFETY: put back at its place, as changes need.
+        let _ = unsafe { mapping.RemoveEntry(index) };
+        // SAFETY: as above.
+        let _ = unsafe { mapping.InsertEntry(index, &entry) };
+        log(&format!("clear-focus-mapping: entry {index} class {class:?} {cleared:?}"));
+    }
+}
+
+/// Runs the probe with `args`: the log's path, the target's process id,
+/// and the ready file's path. Never returns.
+pub(crate) fn run(args: &[String]) -> ! {
+    let (log_path, pid, ready, clear) = match args {
+        [log_path, pid, ready] => (log_path, pid, ready, false),
+        [log_path, pid, ready, flag] if flag == "clear-focus-mapping" => (log_path, pid, ready, true),
+        _ => {
+            eprintln!("mockapp --focus-probe <log> <pid> <ready> [clear-focus-mapping]");
+            std::process::exit(2);
+        }
+    };
+    let pid: u32 = pid.parse().expect("a process id");
+    let _ = TARGET.set(pid);
+    let _ = LOG.set(Mutex::new(File::create(log_path).expect("the log")));
+    let (shown_tx, shown_rx) = mpsc::channel();
+    let _ = SHOWN.set(Mutex::new(shown_tx));
+    log(&format!("start target={pid}"));
+
+    // The one thread that adds handlers, as Microsoft's threading page asks.
+    let ready = ready.clone();
+    std::thread::spawn(move || {
+        // SAFETY: joins this thread to the multithreaded apartment.
+        let _ = unsafe { CoInitializeEx(None, COINIT_MULTITHREADED) };
+        // SAFETY: creates UIA's client object in this process.
+        let uia: IUIAutomation6 =
+            unsafe { CoCreateInstance(&CUIAutomation8, None, CLSCTX_INPROC_SERVER) }.expect("UIA");
+        if clear {
+            clear_focus_mapping(&uia);
+        }
+        // SAFETY: a local call on a live client.
+        let cache = unsafe { uia.CreateCacheRequest() }.expect("cache");
+        for property in [
+            UIA_ProcessIdPropertyId,
+            UIA_RuntimeIdPropertyId,
+            UIA_NamePropertyId,
+            UIA_ControlTypePropertyId,
+            UIA_NativeWindowHandlePropertyId,
+            UIA_HasKeyboardFocusPropertyId,
+        ] {
+            // SAFETY: a local call on a live cache request.
+            unsafe { cache.AddProperty(property) }.expect("a property");
+        }
+        let desktop: IUIAutomationFocusChangedEventHandler = DesktopFocus.into();
+        let started = now_us();
+        // SAFETY: live client, cache and handler.
+        let added = unsafe { uia.AddFocusChangedEventHandler(&cache, &desktop) };
+        log(&format!(
+            "registered desktop took_us={} result={added:?}",
+            now_us() - started
+        ));
+        let scoped: IUIAutomationEventHandler = ScopedFocus.into();
+        let mut windows: Vec<isize> = Vec::new();
+        // SAFETY: the callback writes into `windows`, live for the call.
+        let _ = unsafe { EnumWindows(Some(collect), LPARAM((&raw mut windows) as isize)) };
+        for &hwnd in &windows {
+            register(&uia, &cache, &scoped, hwnd);
+        }
+        std::fs::write(&ready, b"ready").expect("the ready file");
+        let mut registered = windows;
+        while let Ok(hwnd) = shown_rx.recv() {
+            if !registered.contains(&hwnd) {
+                registered.push(hwnd);
+                register(&uia, &cache, &scoped, hwnd);
+            }
+        }
+    });
+
+    // The new-window hook, pumped on this thread.
+    // SAFETY: an out-of-context hook for the target's show events.
+    let hook = unsafe {
+        SetWinEventHook(
+            EVENT_OBJECT_SHOW,
+            EVENT_OBJECT_SHOW,
+            None,
+            Some(shown),
+            pid,
+            0,
+            WINEVENT_OUTOFCONTEXT,
+        )
+    };
+    log(&format!("hooked {}", !hook.is_invalid()));
+    // The MSAA focus hook covers every process, so a window hosting
+    // another process's content (Settings in ApplicationFrameHost) is seen;
+    // its callback acquires the object, which needs COM on this thread.
+    // SAFETY: joins this thread to the multithreaded apartment.
+    let _ = unsafe { CoInitializeEx(None, COINIT_MULTITHREADED) };
+    // SAFETY: an out-of-context hook for every process's focus events.
+    let focus_hook = unsafe {
+        SetWinEventHook(
+            EVENT_OBJECT_FOCUS,
+            EVENT_OBJECT_FOCUS,
+            None,
+            Some(shown),
+            0,
+            0,
+            WINEVENT_OUTOFCONTEXT,
+        )
+    };
+    log(&format!("focus hooked {}", !focus_hook.is_invalid()));
+    let mut message = MSG::default();
+    // SAFETY: this thread's own message loop.
+    while unsafe { GetMessageW(&raw mut message, None, 0, 0) }.as_bool() {
+        // SAFETY: the message just taken.
+        unsafe { DispatchMessageW(&raw const message) };
+    }
+    std::process::exit(0);
+}
