+++ b/crates/verbatim-e2e/src/scenarios/experiment_focus_routes.rs
@@ -0,0 +1,281 @@
+//! Experiments, not tests (scratchpad `focus-pipeline-design.md`, the (b2)
+//! live check): whether a UIA focus registration in an event handler group
+//! scoped to an application's top-level window receives every focus event
+//! the desktop-wide `AddFocusChangedEventHandler` receives, in real
+//! applications, and how quickly each delivers.
+//!
+//! Each scenario opens its target with the harness's own helpers, from the
+//! minimized desktop, starts the probe (`mockapp --focus-probe`, staged
+//! beside Verbatim) on the target's process, and presses keys that move the
+//! focus, confirming the target is in front before every key and taking
+//! whatever Verbatim says without asserting it. Then it opens a new
+//! top-level window of the same application where it can, to time the
+//! probe's registration on a window that has just appeared. The probe's log
+//! and the scenario's key times are printed with an `EXPERIMENT` prefix
+//! and saved beside the artifacts as `experiment-<name>.log`.
+
+use std::io;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use crate::registry::ScenarioState;
+use crate::scenario::{Document, Scenario, WINDOW_TIMEOUT, harness_marker};
+
+pub(crate) use super::no_teardown as teardown;
+
+/// The Notepad document.
+const NOTEPAD: &str = "experiment-routes";
+
+fn now_us() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |since| since.as_micros())
+}
+
+/// The probe and its log.
+struct Probe {
+    pid: u32,
+    log: String,
+    name: &'static str,
+}
+
+/// Takes whatever Verbatim has said, unasserted: these are experiments.
+fn take_speech(scenario: &mut Scenario) {
+    let heard: Vec<String> = scenario
+        .take_until_idle()
+        .into_iter()
+        .map(|heard| heard.text)
+        .collect();
+    println!("EXPERIMENT {} heard {heard:?}", now_us());
+}
+
+/// Starts the probe on the process owning the window titled with `marker`,
+/// which must be in front.
+fn start_probe(scenario: &mut Scenario, name: &'static str, marker: &str) -> Probe {
+    start_probe_with(scenario, name, marker, false)
+}
+
+/// [`start_probe`], with the probe's client told never to map a WinEvent
+/// to a UIA focus change when `clear_focus_mapping`.
+fn start_probe_with(
+    scenario: &mut Scenario,
+    name: &'static str,
+    marker: &str,
+    clear_focus_mapping: bool,
+) -> Probe {
+    take_speech(scenario);
+    let window = scenario
+        .wait_for_window_in_front(marker, WINDOW_TIMEOUT)
+        .expect("the target is in front");
+    let log = scenario.harness_file(&format!("{name}-probe"), "txt");
+    let ready = scenario.harness_file(&format!("{name}-probe-ready"), "txt");
+    let exe = format!(r"{}\mockapp.exe", scenario.run_directory());
+    let mut args = vec![
+        "--focus-probe".to_owned(),
+        log.clone(),
+        window.pid.to_string(),
+        ready.clone(),
+    ];
+    if clear_focus_mapping {
+        args.push("clear-focus-mapping".to_owned());
+    }
+    let pid = scenario
+        .launch_helper(&exe, &args)
+        .expect("the probe starts");
+    scenario
+        .wait_for_agent_file(&ready, WINDOW_TIMEOUT)
+        .expect("the probe registers");
+    println!(
+        "EXPERIMENT {} probe {pid} on {} pid {} ({})",
+        now_us(),
+        window.title,
+        window.pid,
+        window.image
+    );
+    Probe { pid, log, name }
+}
+
+/// Presses `key` once the window titled with `marker` is in front, and
+/// takes what Verbatim says.
+fn press(scenario: &mut Scenario, marker: &str, key: &str) {
+    scenario
+        .wait_for_window_in_front(marker, WINDOW_TIMEOUT)
+        .expect("the target is in front before the key");
+    println!("EXPERIMENT {} key {key:?} in {marker:?}", now_us());
+    scenario.send_keys(&[key]).expect("sends the key");
+    take_speech(scenario);
+}
+
+/// Ends the probe and saves its log.
+fn finish(scenario: &mut Scenario, probe: &Probe) {
+    take_speech(scenario);
+    scenario.end_helper(probe.pid).expect("the probe ends");
+    let log = scenario.read_agent_file(&probe.log).expect("the probe's log");
+    let log = String::from_utf8_lossy(&log).into_owned();
+    for line in log.lines() {
+        println!("EXPERIMENT probe {line}");
+    }
+    let saved = crate::artifacts::artifacts_root().join(format!("experiment-{}.log", probe.name));
+    if let Some(parent) = saved.parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    std::fs::write(&saved, log).expect("saves the probe's log");
+}
+
+/// The Notepad document, opened before Verbatim starts.
+pub(crate) fn notepad_document() -> Document {
+    Document {
+        name: NOTEPAD,
+        contents: "first line\nsecond line\n".to_owned(),
+    }
+}
+
+pub(crate) fn notepad_setup(scenario: &mut Scenario) -> io::Result<ScenarioState> {
+    scenario.bring_document_forward(NOTEPAD)?;
+    Ok(ScenarioState::None)
+}
+
+/// Windows 11 Notepad: its File menu, then a new window (Control+Shift+N),
+/// closed again with Control+W.
+pub(crate) fn notepad_body(scenario: &mut Scenario, _state: &mut ScenarioState) {
+    let marker = harness_marker(NOTEPAD);
+    let probe = start_probe(scenario, "notepad", &marker);
+    for key in ["alt+f", "downarrow", "escape"] {
+        press(scenario, &marker, key);
+    }
+    press(scenario, &marker, "control+shift+n");
+    press(scenario, "Untitled - Notepad", "control+w");
+    press(scenario, &marker, "downarrow");
+    finish(scenario, &probe);
+}
+
+pub(crate) fn windows_terminal_setup(scenario: &mut Scenario) -> io::Result<ScenarioState> {
+    super::terminal::open_windows_terminal(scenario, "experiment-routes-terminal", &[])
+}
+
+/// The harness's Windows Terminal: its command palette, then a second
+/// window of the same Windows Terminal, and its command palette.
+pub(crate) fn windows_terminal_body(scenario: &mut Scenario, state: &mut ScenarioState) {
+    let marker = super::terminal::title(state).to_owned();
+    let probe = start_probe(scenario, "windows_terminal", &marker);
+    for key in ["control+shift+p", "escape"] {
+        press(scenario, &marker, key);
+    }
+    println!("EXPERIMENT {} opening a second window", now_us());
+    let second = super::terminal::open_windows_terminal_window(
+        scenario,
+        "experiment-routes-terminal-two",
+        state,
+    )
+    .expect("opens a second window");
+    let second = super::terminal::title(&second).to_owned();
+    take_speech(scenario);
+    for key in ["control+shift+p", "escape"] {
+        press(scenario, &second, key);
+    }
+    finish(scenario, &probe);
+}
+
+pub(crate) fn explorer_setup(scenario: &mut Scenario) -> io::Result<ScenarioState> {
+    let title = scenario.open_folder(
+        "experiment-routes-folder",
+        &["alpha", "beta", "gamma", "Inner\\delta"],
+    )?;
+    Ok(ScenarioState::Title(title))
+}
+
+/// A File Explorer folder window: its items, into the subfolder and back,
+/// the panes with F6, then a new window of the folder (Control+N). Enter
+/// is pressed only on the subfolder, "Inner", the first item once Home
+/// has moved there (folders sort first), so no file is ever opened.
+pub(crate) fn explorer_body(scenario: &mut Scenario, state: &mut ScenarioState) {
+    let ScenarioState::Title(marker) = state else {
+        panic!("setup opens the folder");
+    };
+    let marker = marker.clone();
+    let probe = start_probe(scenario, "explorer", &marker);
+    for key in ["downarrow", "downarrow", "home", "enter", "backspace", "f6", "f6"] {
+        press(scenario, &marker, key);
+    }
+    press(scenario, &marker, "control+n");
+    press(scenario, &marker, "downarrow");
+    finish(scenario, &probe);
+}
+
+pub(crate) fn settings_setup(scenario: &mut Scenario) -> io::Result<ScenarioState> {
+    scenario.open_settings_page("ms-settings:system")?;
+    Ok(ScenarioState::None)
+}
+
+/// The Settings app's System page (content in `SystemSettings`, frame in
+/// `ApplicationFrameHost`): from the search box into the navigation list
+/// and back. It opens nothing.
+pub(crate) fn settings_body(scenario: &mut Scenario, _state: &mut ScenarioState) {
+    let probe = start_probe(scenario, "settings", "Settings");
+    for key in ["tab", "downarrow", "uparrow", "shift+tab"] {
+        press(scenario, "Settings", key);
+    }
+    finish(scenario, &probe);
+}
+
+/// msinfo32's window title.
+const MSINFO: &str = "System Information";
+
+pub(crate) fn msinfo_setup(scenario: &mut Scenario) -> io::Result<ScenarioState> {
+    scenario.require_absent(MSINFO)?;
+    scenario.launch_titled("msinfo32.exe", &[], MSINFO, true)?;
+    Ok(ScenarioState::None)
+}
+
+/// msinfo32, with the probe's focus mapping cleared: its Win32 tree view
+/// (`SysTreeView32`) and list view (`SysListView32`, the one class whose
+/// proxy maps a WinEvent to a UIA focus change), both read by UIA's
+/// proxies; the probe logs the UIA focus handler's and the MSAA focus
+/// hook's view of each focus change.
+pub(crate) fn msinfo_mapping_body(scenario: &mut Scenario, _state: &mut ScenarioState) {
+    let probe = start_probe_with(scenario, "msinfo_cleared", MSINFO, true);
+    for key in ["downarrow", "uparrow", "tab", "downarrow", "downarrow", "shift+tab"] {
+        press(scenario, MSINFO, key);
+    }
+    finish(scenario, &probe);
+}
+
+/// The same walk in msinfo32 with the focus mapping as it is, for the
+/// comparison.
+pub(crate) fn msinfo_body(scenario: &mut Scenario, _state: &mut ScenarioState) {
+    let probe = start_probe_with(scenario, "msinfo", MSINFO, false);
+    for key in ["downarrow", "uparrow", "tab", "downarrow", "downarrow", "shift+tab"] {
+        press(scenario, MSINFO, key);
+    }
+    finish(scenario, &probe);
+}
+
+/// The Windows Forms text box with the probe's focus mapping cleared.
+pub(crate) fn text_box_mapping_body(scenario: &mut Scenario, _state: &mut ScenarioState) {
+    let marker = harness_marker("experiment-routes-box");
+    let probe = start_probe_with(scenario, "text_box_cleared", &marker, true);
+    for key in ["alt+space", "escape", "alt+space", "escape"] {
+        press(scenario, &marker, key);
+    }
+    finish(scenario, &probe);
+}
+
+pub(crate) fn text_box_setup(scenario: &mut Scenario) -> io::Result<ScenarioState> {
+    let pid = super::text_box::open(
+        scenario,
+        "experiment-routes-box",
+        super::text_box::BOX_NAME,
+        "first line\r\nsecond line\r\n",
+    )?;
+    Ok(ScenarioState::TargetPid(pid))
+}
+
+/// The suite's Windows Forms text box, a Win32 edit control UIA proxies:
+/// its system menu and back, twice. It opens no second window.
+pub(crate) fn text_box_body(scenario: &mut Scenario, _state: &mut ScenarioState) {
+    let marker = harness_marker("experiment-routes-box");
+    let probe = start_probe(scenario, "text_box", &marker);
+    for key in ["alt+space", "escape", "alt+space", "escape"] {
+        press(scenario, &marker, key);
+    }
+    finish(scenario, &probe);
+}
