new file mode 100644
index 00000000..2a0b36eb
--- /dev/null
+++ b/crates/verbatim-outpost/src/rework_measure.rs
@@ -0,0 +1,105 @@
+//! Scratch measurement for the focus pipeline rework's step 1 (never
+//! merged): the listener's record of the focus and foreground events its
+//! callbacks observed, by top-level window, for the Terms' currency rule
+//! of a kept read (`docs/design/focus-pipeline-rework.md`, "Terms"). Every
+//! line it feeds is logged under the target [`TARGET`].
+
+use std::collections::VecDeque;
+use std::sync::{Mutex, PoisonError};
+
+use verbatim_model::TraceId;
+
+use crate::outpost::window::top_level_of;
+
+/// The log target of every measurement line.
+pub const TARGET: &str = "rework_measure";
+
+/// How long an observation is kept: longer than any kept read waits for its
+/// next event in a scenario.
+const KEPT_US: u64 = 120_000_000;
+
+/// One focus or foreground event a listener callback observed.
+struct Move {
+    at_us: u64,
+    /// Its top-level window, or `None` for a UIA sender with no window of
+    /// its own, until its reading thread places it.
+    top: Option<isize>,
+    pid: u32,
+    /// The trace of a UIA focus, by which its reading thread places it.
+    trace: Option<TraceId>,
+}
+
+static MOVES: Mutex<VecDeque<Move>> = Mutex::new(VecDeque::new());
+
+fn record(entry: Move) {
+    let mut moves = MOVES.lock().unwrap_or_else(PoisonError::into_inner);
+    let oldest = entry.at_us.saturating_sub(KEPT_US);
+    while moves.front().is_some_and(|front| front.at_us < oldest) {
+        moves.pop_front();
+    }
+    moves.push_back(entry);
+}
+
+/// A `WinEvent` focus or foreground change in `hwnd`, of `pid`, observed at
+/// `at_us`: one `GetAncestor`.
+pub fn observed_win_event(at_us: u64, hwnd: isize, pid: u32) {
+    record(Move {
+        at_us,
+        top: Some(top_level_of(hwnd)),
+        pid,
+        trace: None,
+    });
+}
+
+/// A UIA focus traced `trace` whose sender's cached window is `hwnd` (0
+/// for none), of `pid`, observed at `at_us`.
+pub fn observed_uia_focus(at_us: u64, hwnd: isize, pid: u32, trace: TraceId) {
+    record(Move {
+        at_us,
+        top: (hwnd != 0).then(|| top_level_of(hwnd)),
+        pid,
+        trace: Some(trace),
+    });
+}
+
+/// The reading thread found the nearest window `nearest` of the UIA focus
+/// traced `trace`, whose sender has no window of its own.
+pub fn place(trace: TraceId, nearest: isize) {
+    let mut moves = MOVES.lock().unwrap_or_else(PoisonError::into_inner);
+    if let Some(entry) = moves
+        .iter_mut()
+        .rev()
+        .find(|entry| entry.trace == Some(trace) && entry.top.is_none())
+    {
+        entry.top = Some(top_level_of(nearest));
+    }
+}
+
+/// Whether a kept read of `pid`'s, read for the event observed at
+/// `kept_at_us` in top-level window `kept_top`, is current for the event
+/// observed at `judged_at_us`: no focus or foreground event in another
+/// top-level window was observed strictly between the two. Another
+/// application's windowless UIA sender counts as elsewhere; one of `pid`'s
+/// counts by the window its reading thread placed it in, and one it has not
+/// placed counts as elsewhere. Answers the currency and how many of
+/// `pid`'s windowless senders were unplaced.
+pub fn current(pid: u32, kept_at_us: u64, kept_top: isize, judged_at_us: u64) -> (bool, u32) {
+    let moves = MOVES.lock().unwrap_or_else(PoisonError::into_inner);
+    let mut current = true;
+    let mut unplaced = 0;
+    for entry in moves
+        .iter()
+        .filter(|entry| entry.at_us > kept_at_us && entry.at_us < judged_at_us)
+    {
+        match entry.top {
+            Some(top) if top != kept_top => current = false,
+            Some(_) => {}
+            None if entry.pid != pid => current = false,
+            None => {
+                unplaced += 1;
+                current = false;
+            }
+        }
+    }
+    (current, unplaced)
+}
