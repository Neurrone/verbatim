@@ -0,0 +1,64 @@
+//! Scratch check for the focus pipeline rework's measurement patch (never
+//! merged): a listener read and an outpost, on a desktop of their own,
+//! print the patch's `rework_measure` lines to standard error.
+
+mod common;
+#[path = "common/harness.rs"]
+mod harness;
+
+use verbatim_outpost::focus_read::{FocusEvent, Judged};
+use verbatim_outpost::protocol::DeliveredFact;
+use verbatim_uia::Uia;
+
+use common::outpost::OutpostUnderTest;
+
+/// A UIA focus read twice by the listener's reader and handed to an outpost
+/// whose hand-over ends, then an MSAA focus handed twice to another.
+fn the_measurement_lines_are_logged() {
+    tracing_subscriber::fmt()
+        .with_env_filter("rework_measure=debug")
+        .with_writer(std::io::stderr)
+        .init();
+
+    let title = common::unique_title("rework-check-uia");
+    let mut app = common::spawn("small.json", "uia", &title);
+    let hwnd = common::find_window(&title);
+    let uia = Uia::new().expect("a UIA client");
+    let outpost = OutpostUnderTest::new(&app);
+    outpost.forwarding_ended(verbatim_ia2::event_clock());
+    app.send("set-focus btn1");
+    let first = outpost.uia_focus(&common::listener_focus(&uia, hwnd.0 as isize));
+    assert_eq!(first.node.name.as_deref(), Some("Original Name"));
+    let (judged, _) = outpost.listener_read(&common::listener_focus(&uia, hwnd.0 as isize));
+    assert!(
+        matches!(judged, Judged::Dropped(_)),
+        "today's listener drops the repeat"
+    );
+    outpost.deliver(judged.into_fact(0, FocusEvent::Focus));
+    outpost.settled();
+    drop(outpost);
+    app.quit();
+
+    let title = common::unique_title("rework-check-msaa");
+    let mut app = common::spawn("small.json", "msaa", &title);
+    let hwnd = common::find_window(&title);
+    let outpost = OutpostUnderTest::new(&app);
+    app.send("set-focus btn1");
+    let first = outpost.msaa_focus(hwnd, 1);
+    assert_eq!(first.node.name.as_deref(), Some("Original Name"));
+    outpost.deliver(DeliveredFact::MsaaFocus {
+        hwnd: hwnd.0 as isize,
+        id_object: 2,
+        id_child: 0,
+    });
+    outpost.settled();
+    drop(outpost);
+    app.quit();
+}
+
+fn main() {
+    harness::run_isolated(&[(
+        "the_measurement_lines_are_logged",
+        the_measurement_lines_are_logged,
+    )]);
+}
