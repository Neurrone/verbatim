+/// Scratch judge: opens Windows Terminal and a second window in it, then
+/// closes both, `VERBATIM_IDENTITY_ROUNDS` times (default 20).
+pub(crate) fn setup_terminal_identities(_scenario: &mut Scenario) -> io::Result<ScenarioState> {
+    Ok(ScenarioState::None)
+}
+
+/// `measure_terminal_identities`.
+pub(crate) fn body_terminal_identities(scenario: &mut Scenario, _state: &mut ScenarioState) {
+    let rounds: usize = std::env::var("VERBATIM_IDENTITY_ROUNDS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(20);
+    for round in 0..rounds {
+        let first_state = terminal::open_windows_terminal(scenario, &format!("ida{round}"), &[])
+            .expect("opens Windows Terminal");
+        let ScenarioState::Window { pid, .. } = &first_state else {
+            unreachable!()
+        };
+        let pid = *pid;
+        let first = terminal::title(&first_state).to_owned();
+        std::thread::sleep(std::time::Duration::from_millis(1500));
+        let _ = scenario.take_all_queued();
+        let second_state =
+            terminal::open_windows_terminal_window(scenario, &format!("idb{round}"), &first_state)
+                .expect("opens a second window");
+        let second = terminal::title(&second_state).to_owned();
+        std::thread::sleep(std::time::Duration::from_millis(1500));
+        let _ = scenario.take_all_queued();
+        scenario.close_windows_titled(&second).expect("closes the second");
+        scenario.close_windows_titled(&first).expect("closes the first");
+        scenario
+            .wait_for_pid_exit(pid, std::time::Duration::from_secs(10))
+            .expect("Windows Terminal exits");
+        std::thread::sleep(std::time::Duration::from_millis(500));
+        let _ = scenario.take_all_queued();
+        eprintln!("identity round {round} done");
+    }
+}
