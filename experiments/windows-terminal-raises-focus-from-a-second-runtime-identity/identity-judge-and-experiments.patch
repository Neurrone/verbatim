+/// EXPERIMENT (scratch, reverted): every part's handler behind one COM
+/// object, as NVDA registers its one handler object for everything.
+fn combine(mut built: Vec<Built>) -> windows::core::Result<Vec<Built>> {
+    tracing::info!("EXPERIMENT: one handler object");
+    let mut combined = handlers::Combined {
+        focus: None,
+        events: Vec::new(),
+        properties: None,
+        notifications: None,
+        active_text_position: None,
+    };
+    for part in &built {
+        match &part.handler {
+            Handler::Focus(handler) => combined.focus = Some(handler.clone()),
+            Handler::Event(handler, event) => combined.events.push((*event, handler.clone())),
+            Handler::Events(handler, events) => {
+                for event in events {
+                    combined.events.push((*event, handler.clone()));
+                }
+            }
+            Handler::Properties(handler, _) => combined.properties = Some(handler.clone()),
+            Handler::Notifications(handler) => combined.notifications = Some(handler.clone()),
+            Handler::ActiveTextPosition(handler) => {
+                combined.active_text_position = Some(handler.clone());
+            }
+        }
+    }
+    let unknown: windows_core::IUnknown = combined.into();
+    for part in &mut built {
+        part.handler = match &part.handler {
+            Handler::Focus(_) => Handler::Focus(unknown.cast()?),
+            Handler::Event(_, event) => Handler::Event(unknown.cast()?, *event),
+            Handler::Events(_, events) => Handler::Events(unknown.cast()?, events.clone()),
+            Handler::Properties(_, properties) => {
+                Handler::Properties(unknown.cast()?, properties.clone())
+            }
+            Handler::Notifications(_) => Handler::Notifications(unknown.cast()?),
+            Handler::ActiveTextPosition(_) => Handler::ActiveTextPosition(unknown.cast()?),
+        };
+    }
+    Ok(built)
+}
