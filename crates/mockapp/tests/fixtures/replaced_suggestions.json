{
  "id": "root",
  "role": "window",
  "name": "Mockapp Replaced Suggestions Fixture",
  "children": [
    {
      "id": "search",
      "role": "editable_text",
      "name": "Search box",
      "automation_id": "SearchTextBox",
      "states": ["focusable"],
      "controller_for": "suggestions"
    },
    {
      "id": "suggestions",
      "role": "list",
      "name": "Suggestions",
      "children": [
        {
          "id": "sound",
          "role": "list_item",
          "name": "Sound settings",
          "states": ["focusable", "selectable"],
          "position_in_set": 1,
          "set_size": 2
        },
        {
          "id": "display",
          "role": "list_item",
          "name": "Display settings",
          "states": ["focusable", "selectable"],
          "position_in_set": 2,
          "set_size": 2
        }
      ]
    },
    {
      "id": "categories",
      "role": "list",
      "name": "Categories",
      "states": ["focusable"],
      "controller_for": "suggestions",
      "children": [
        {
          "id": "general",
          "role": "list_item",
          "name": "General",
          "states": ["focusable", "selectable"],
          "position_in_set": 1,
          "set_size": 1
        }
      ]
    }
  ]
}
