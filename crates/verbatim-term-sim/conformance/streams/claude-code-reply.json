    "\u001b[?25l\u001b[?2026h\u001b[38;2;255;255;255m\u001b[9;1H●\u001b[m\u001b[1m\u001b[4m\u001b[3m\u001b[1CHow a Lighthouse Works\u001b[22m\u001b[24m\u001b[23m\u001b[K\u001b[11;1H  A lighthouse is a tower that marks a dangerous or important point on the coast so that ships can navigate safely,     \r\n  especially\u001b[1Cat\u001b[1Cnight\u001b[1Cor\u001b[1Cin\u001b[1Cpoor\u001b[1Cvisibility.\u001b[1CIts\u001b[1Cthree\u001b[1Cmain\u001b[1Cparts\u001b[1Care:\r\n\u001b[K\u001b[14;3H- \u001b[1mThe light source.\u001b[22m A lamp, once an oil or gas flame and\u001b[1Cnow\u001b[1Cusually\u001b[1Can\u001b[1CLED,\u001b[1Cproduces\u001b[1Cthe\u001b[1Cbeam.\u001b[15;3H-\u001b[1m\u001b[1CThe\u001b[1Coptic.\u001b[22m\u001b[1CA\u001b[1Csystem\u001b[1Cof\u001b[1Clenses\u001b[1Cand\u001b[1Cprisms,\u001b[1Coften\u001b[1Ca\u001b[1CFresnel\u001b[1Clens,\u001b[1Cgathers\u001b[1Cthe\u001b[1Clight\u001b[1Cfrom\u001b[1Cthe\u001b[1Clamp\u001b[1Cand\u001b[1Cfocuses\u001b[1Cit\u001b[1Cinto\u001b[16;5Ha\u001b[1Cconcentrated\u001b[1Cbeam\u001b[1Cinstead\u001b[1Cof\u001b[1Cletting\u001b[1Cit\u001b[1Cspread\u001b[1Cin\u001b[1Call\u001b[1Cdirections.\u001b[17;3H-\u001b[1m\u001b[1CThe\u001b[1Crotating\u001b[1Cmechanism.\u001b[22m\u001b[1CA\u001b[1Cclockwork\u001b[1Cor\u001b[1Cmotor\u001b[1Cturns\u001b[1Cthe\u001b[1Coptic\u001b[1Cso\u001b[1Cthe\u001b[1Cbeam\u001b[1Csweeps\u001b[1Cacross\u001b[1Cthe\u001b[1Chorizon.\u001b[1CEach\u001b[1Clighthouse\u001b[18;5Hhas\u001b[1Cits\u001b[1Cown\u001b[1Cflash\u001b[1Cpattern,\u001b[1Cso\u001b[1Csailors\u001b[1Ccan\u001b[1Ctell\u001b[1Cwhich\u001b[1Clight\u001b[1Cthey\u001b[1Care\u001b[1Cseeing.\u001b[20;3HThe\u001b[1Clamp\u001b[1Csits\u001b[1Cat\u001b[1Cthe\u001b[1Ccenter\u001b[1Cof\u001b[1Cthe\u001b[1Coptic,\u001b[1Cand\u001b[1Cthe\u001b[1Coptic\u001b[1Cis\u001b[1Cmounted\u001b[1Con\u001b[1Ca\u001b[1Cturntable\u001b[1Cor\u001b[1Cinside\u001b[1Ca\u001b[1Crotating\u001b[1Cdrum.\u001b[1CIts\u001b[21;3Hcurved\u001b[1Cglass\u001b[1Cpanels\u001b[1Cbend\u001b[1Clight\u001b[1Cthat\u001b[1Cwould\u001b[1Cotherwise\u001b[1Cescape\u001b[1Cupward\u001b[1Cor\u001b[1Cdownward\u001b[1Cinto\u001b[1Ca\u001b[1Cnarrow\u001b[1Chorizontal\u001b[1Cband.\u001b[1CThe\u001b[22;3Hresult\u001b[1Cis\u001b[1Ca\u001b[1Cbeam\u001b[1Cthat\u001b[1Cis\u001b[1Cmuch\u001b[1Cbrighter\u001b[1Cat\u001b[1Csea\u001b[1Cthan\u001b[1Cthe\u001b[1Cbare\u001b[1Cflame\u001b[1Cwould\u001b[1Cbe,\u001b[1Cand\u001b[1Cthe\u001b[1Crotation\u001b[1Cmakes\u001b[1Cit\u001b[1Cappear\u001b[1Cas\u001b[1Ca\u001b[23;3Hflash\u001b[1Crather\u001b[1Cthan\u001b[1Ca\u001b[1Csteady\u001b[1Cglow.\u001b[25;3HThe\u001b[1Ctower's\u001b[1Cheight\u001b[1Cmatters\u001b[1Cas\u001b[1Cwell.\u001b[1CA\u001b[1Chigher\u001b[1Clight\u001b[1Ccan\u001b[1Cbe\u001b[1Cseen\u001b[1Cfrom\u001b[1Cfarther\u001b[1Caway,\u001b[1Cbecause\u001b[1Cthe\u001b[1Ccurve\u001b[1Cof\u001b[1Cthe\u001b[1CEarth\u001b[26;3Hlimits\u001b[1Chow\u001b[1Cfar\u001b[1Ca\u001b[1Clight\u001b[1Cnear\u001b[1Cthe\u001b[1Cwater\u001b[1Ccan\u001b[1Creach\u001b[1Cthe\u001b[1Chorizon.\u001b[1CModern\u001b[1Clighthouses\u001b[1Coften\u001b[1Crun\u001b[1Cautomatically\u001b[1Con\u001b[1Csolar\u001b[1Cor\u001b[27;3Hmains\u001b[1Cpower,\u001b[1Cand\u001b[1Cmany\u001b[1Cnow\u001b[1Cuse\u001b[1CGPS\u001b[1Cand\u001b[1Cradio\u001b[1Cbeacons\u001b[1Calongside\u001b[1Cthe\u001b[1Clight,\u001b[1Cbut\u001b[1Cthe\u001b[1Cbasic\u001b[1Cprinciple\u001b[1Cof\u001b[1Ca\u001b[1Cfocused,\u001b[28;3Hrotating\u001b[1Cbeam\u001b[1Cthat\u001b[1Cidentifies\u001b[1Ca\u001b[1Clocation\u001b[1Chas\u001b[1Cnot\u001b[1Cchanged\u001b[1Cfor\u001b[1Cabout\u001b[1Ctwo\u001b[1Ccenturies.\u001b[38;2;153;153;153m\u001b[30;1H✻\u001b[1CChurned\u001b[1Cfor\u001b[1C4s\u001b[1C·\u001b[1Cdone\u001b[1C12:03\u001b[1CPM\u001b[m\r\n\u001b[120C\r\n\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[m\r\n❯ \u001b[118C\r\n\u001b[38;2;136;136;136m──────────────────────────────────────────